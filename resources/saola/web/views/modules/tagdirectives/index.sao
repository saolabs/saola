@import('web.components.code-block')

<script setup lang="ts">
    interface Row {
        id: string;
        name: string;
        on: boolean;
    }

    @states({
        mode = 'a',
        n = 0,
        rows = [
            { id: 'r1', name: 'Hàng một', on: true },
            { id: 'r2', name: 'Hàng hai', on: false },
            { id: 'r3', name: 'Hàng ba', on: true }
        ]
    }: {
        mode: string;
        n: number;
        rows: Row[];
    })

    function pickA() { setMode('a'); }
    function pickB() { setMode('b'); }
    function pickX() { setMode('x'); }
    function bump()  { setN(n + 1); }
    function toggleFirst() {
        setRows(rows.map((r, i) => i === 0 ? { ...r, on: !r['on'] } : r));
    }
</script>

<template>
    @extends(__layout__ + 'lab')
    @section('meta:title', 'So sánh Directive trên Thẻ (#) & Khối (@) - Saola Lab')
    @section('meta:description', 'So sánh trực quan hai phong cách viết directive trong Saola: Cú pháp khối @if/@foreach và cú pháp trực tiếp trên thẻ #if/#foreach chạy song song.')
    @section('meta:keywords', 'tag directives lab, so sanh directive, #if vs @if, hashtag directives, saola lab')

    @block('main')
        <p class="kicker"><span>DIRECTIVE VIẾT TRÊN THẺ</span></p>
        <h1>Cùng một nội dung, hai cách viết.</h1>
        <p class="kb-lead">
            Cột trái dùng directive khối (&#64;if, &#64;switch...), cột phải dùng directive viết trực tiếp trên thẻ (#if, #switch...).
            Compiler tự động hạ cú pháp viết trên thẻ về dạng khối, nên hai cột hoạt động và hiển thị giống hệt nhau.
        </p>

        <div class="td-toolbar">
            <div class="td-control-group">
                <span class="td-group-label">Chọn mode:</span>
                <div class="td-segmented">
                    <button id="btn-a" type="button" @class({'td-seg-btn': true, 'is-active': mode === 'a'}) @click(pickA)>
                        <span>mode = a</span>
                    </button>
                    <button id="btn-b" type="button" @class({'td-seg-btn': true, 'is-active': mode === 'b'}) @click(pickB)>
                        <span>mode = b</span>
                    </button>
                    <button id="btn-x" type="button" @class({'td-seg-btn': true, 'is-active': mode === 'x'}) @click(pickX)>
                        <span>mode = x</span>
                    </button>
                </div>
            </div>

            <div class="td-control-group">
                <span class="td-group-label">Tác vụ:</span>
                <div class="td-actions">
                    <button id="btn-bump" type="button" class="td-btn" @click(bump)>
                        <span>＋ n + 1</span>
                    </button>
                    <button id="btn-toggle" type="button" class="td-btn" @click(toggleFirst)>
                        <span>⇄ Đảo hàng một</span>
                    </button>
                </div>
            </div>

            <div class="td-status-pill">
                <span>mode = <b id="out-mode">{{ mode }}</b></span>
                <span class="td-status-sep">·</span>
                <span>n = <b id="out-n">{{ n }}</b></span>
            </div>
        </div>

        <div class="td-grid">
            <div class="td-col-wrap">
                <header class="td-col-header">
                    <span class="badge-alt">&#64; Cú pháp dạng khối</span>
                </header>

                <section id="viaBlock" class="td-col">
                    <h2>&#64;if / &#64;switch / &#64;foreach</h2>

                    @if(mode === 'a')
                    <p class="td-branch">nhánh A</p>
                    @elseif(mode === 'b')
                    <p class="td-branch">nhánh B</p>
                    @else
                    <p class="td-branch">nhánh khác</p>
                    @endif

                    <div class="td-tabs">
                        @switch(mode)
                        @case('a')
                        <span class="td-tab">tab A</span>
                        @break
                        @case('b')
                        <span class="td-tab">tab B</span>
                        @break
                        @default
                        <span class="td-tab">tab mặc định</span>
                        @endswitch
                    </div>

                    <ul class="td-list">
                        @foreach(rows as row)
                        @key(row['id'])
                        <li class="td-row">
                            <span>{{ row['name'] }}</span>
                            @if(row['on'])
                            <b class="td-flag">bật</b>
                            @endif
                        </li>
                        @endforeach
                    </ul>

                    <p class="td-count">
                        @for(i = 0; i < n; i++)
                        <i class="td-dot">•</i>
                        @endfor
                    </p>
                </section>

                <div class="td-demo-code">
                    <span class="dc-code-label">Mã nguồn template dạng khối (&#64;):</span>
                    <code-block lang="sao">
@verbatim
&lt;template&gt;
    {{-- 1. Rẽ nhánh @if --}}
    &#64;if(mode === 'a')
        &lt;p class="td-branch"&gt;nhánh A&lt;/p&gt;
    &#64;elseif(mode === 'b')
        &lt;p class="td-branch"&gt;nhánh B&lt;/p&gt;
    &#64;else
        &lt;p class="td-branch"&gt;nhánh khác&lt;/p&gt;
    &#64;endif

    {{-- 2. Chọn nhánh @switch --}}
    &lt;div class="td-tabs"&gt;
        &#64;switch(mode)
            &#64;case('a')
                &lt;span class="td-tab"&gt;tab A&lt;/span&gt;
                &#64;break
            &#64;case('b')
                &lt;span class="td-tab"&gt;tab B&lt;/span&gt;
                &#64;break
            &#64;default
                &lt;span class="td-tab"&gt;tab mặc định&lt;/span&gt;
        &#64;endswitch
    &lt;/div&gt;

    {{-- 3. Vòng lặp @foreach có @key --}}
    &lt;ul class="td-list"&gt;
        &#64;foreach(rows as row)
            &#64;key(row['id'])
            &lt;li class="td-row"&gt;
                &lt;span&gt;{{ row['name'] }}&lt;/span&gt;
                &#64;if(row['on'])
                    &lt;b class="td-flag"&gt;bật&lt;/b&gt;
                &#64;endif
            &lt;/li&gt;
        &#64;endforeach
    &lt;/ul&gt;

    {{-- 4. Vòng lặp @for --}}
    &lt;p class="td-count"&gt;
        &#64;for(i = 0; i &lt; n; i++)
            &lt;i class="td-dot"&gt;•&lt;/i&gt;
        &#64;endfor
    &lt;/p&gt;
&lt;/template&gt;
@endverbatim
                    </code-block>
                </div>
            </div>

            <div class="td-col-wrap">
                <header class="td-col-header">
                    <span class="badge-recommended">★ # Cú pháp trên thẻ (Mới)</span>
                </header>

                <section id="viaTag" class="td-col td-col--highlight">
                    <h2>#if / #switch / #foreach</h2>

                    <p class="td-branch" #if="mode === 'a'">nhánh A</p>
                    <p class="td-branch" #elseif="mode === 'b'">nhánh B</p>
                    <p class="td-branch" #else>nhánh khác</p>

                    <div class="td-tabs" #switch="mode">
                        <span class="td-tab" #case="'a'">tab A</span>
                        <span class="td-tab" #case="'b'">tab B</span>
                        <span class="td-tab" #default>tab mặc định</span>
                    </div>

                    <ul class="td-list">
                        <li class="td-row" #foreach="rows as row" #key="row['id']">
                            <span>{{ row['name'] }}</span>
                            <b class="td-flag" #if="row['on']">bật</b>
                        </li>
                    </ul>

                    <p class="td-count">
                        <i class="td-dot" #for="i = 0; i < n; i++">•</i>
                    </p>
                </section>

                <div class="td-demo-code">
                    <span class="dc-code-label">Mã nguồn template trên thẻ (#):</span>
                    <code-block lang="sao">
@verbatim
&lt;template&gt;
    {{-- 1. Rẽ nhánh #if trên thẻ --}}
    &lt;p class="td-branch" #if="mode === 'a'"&gt;nhánh A&lt;/p&gt;
    &lt;p class="td-branch" #elseif="mode === 'b'"&gt;nhánh B&lt;/p&gt;
    &lt;p class="td-branch" #else&gt;nhánh khác&lt;/p&gt;

    {{-- 2. Chọn nhánh #switch trên thẻ cha --}}
    &lt;div class="td-tabs" #switch="mode"&gt;
        &lt;span class="td-tab" #case="'a'"&gt;tab A&lt;/span&gt;
        &lt;span class="td-tab" #case="'b'"&gt;tab B&lt;/span&gt;
        &lt;span class="td-tab" #default&gt;tab mặc định&lt;/span&gt;
    &lt;/div&gt;

    {{-- 3. Vòng lặp #foreach và #key trên thẻ con --}}
    &lt;ul class="td-list"&gt;
        &lt;li class="td-row" #foreach="rows as row" #key="row['id']"&gt;
            &lt;span&gt;{{ row['name'] }}&lt;/span&gt;
            &lt;b class="td-flag" #if="row['on']"&gt;bật&lt;/b&gt;
        &lt;/li&gt;
    &lt;/ul&gt;

    {{-- 4. Vòng lặp #for trên thẻ --}}
    &lt;p class="td-count"&gt;
        &lt;i class="td-dot" #for="i = 0; i &lt; n; i++"&gt;•&lt;/i&gt;
    &lt;/p&gt;
&lt;/template&gt;
@endverbatim
                    </code-block>
                </div>
            </div>
        </div>

        <div class="td-shared-script">
            <span class="dc-code-label">Mã nguồn logic dùng chung (&lt;script setup lang="ts"&gt;):</span>
            <code-block lang="sao">
@verbatim
&lt;script setup lang="ts"&gt;
    interface Row {
        id: string;
        name: string;
        on: boolean;
    }

    &#64;states({
        mode = 'a',
        n = 0,
        rows = [
            { id: 'r1', name: 'Hàng một', on: true },
            { id: 'r2', name: 'Hàng hai', on: false },
            { id: 'r3', name: 'Hàng ba', on: true }
        ]
    }: {
        mode: string;
        n: number;
        rows: Row[];
    })

    function pickA() { setMode('a'); }
    function pickB() { setMode('b'); }
    function pickX() { setMode('x'); }
    function bump()  { setN(n + 1); }
    function toggleFirst() {
        setRows(rows.map((r, i) => i === 0 ? { ...r, on: !r['on'] } : r));
    }
&lt;/script&gt;
@endverbatim
            </code-block>
        </div>
    @endblock

    @block('aside')
        <h2>Quy ước Directive trên thẻ (#)</h2>
        <div class="directive-table">
            <div><div class="dt-key"><code>#if #elseif #else</code></div><span>Bọc cả thẻ. Chuỗi nhánh phải là các sibling liền kề, chỉ cách nhau bởi khoảng trắng.</span><b>rẽ nhánh</b></div>
            <div><div class="dt-key"><code>#switch #case #default</code></div><span><code>#switch</code> bọc <strong>ruột thẻ</strong> (thẻ cha vẫn render). Các con mang <code>#case</code>/<code>#default</code>; <code>&#64;break</code> do compiler tự chèn.</span><b>chọn nhánh</b></div>
            <div><div class="dt-key"><code>#foreach #for #while</code></div><span>Bọc cả thẻ. Nhận kèm <code>#key</code> để định danh identity trong DOM reconciliation.</span><b>vòng lặp</b></div>
            <div><div class="dt-key"><code>#key</code></div><span>Ngoại lệ duy nhất đi kèm directive lặp trên cùng một thẻ.</span><b>khoá</b></div>
        </div>
        <p class="lab-note">
            <strong>Tập đóng:</strong> Namespace <code>#</code> là tập đóng (E-07 RFC). Gõ sai như <code>#fi="x"</code> sẽ báo lỗi biên dịch ngay lập tức để tránh rò rỉ thành thuộc tính HTML rác. Dấu <code>#</code> ở thuộc tính thường như <code>style="color: #fff"</code> hoặc <code>href="#top"</code> không bị ảnh hưởng.
        </p>
    @endblock
</template>

<link rel="stylesheet" href="/static/saola/tag-directives.css">
