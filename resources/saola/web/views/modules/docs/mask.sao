@import('web.components.code-window')
<template>
    @extends(__layout__ + "docs")
    @block('doc')
        <header class="page-hero">
            <div>
                <p class="kicker"><span>08</span> BACKEND</p>
                <h1>Mask, model và collection.</h1>
            </div>
            <div class="page-hero-aside">
                <p>Model quản lý cấu trúc bảng và truy vấn cơ sở dữ liệu. Mask là lớp mặt nạ đại diện (Proxy/Decorator) bọc ngoài Model để kiểm soát dữ liệu xuất ra ngoài, map các quan hệ sang Mask tương ứng và cung cấp các hàm tiện ích an toàn cho View.</p>
            </div>
        </header>

        <div class="doc-body">
            <p class="kicker"><span>01. BẢN CHẤT KIẾN TRÚC</span> Model vs Mask</p>
            <h2>Mask là lớp mặt nạ đại diện bảo vệ Model.</h2>
            <p>Trong kiến trúc Saola, Model không bao giờ được trả thô trực tiếp ra View hoặc API. Thay vào đó, <strong>Mask</strong> đóng vai trò là một Proxy an toàn bao bọc lấy Model:</p>

            <div class="directive-table">
                <div><div class="dt-key"><code>Model (Eloquent)</code></div><span>Tầng dữ liệu nội bộ. Quản lý schema bảng, fillable, hidden, relationships và query builder. Chỉ hoạt động trong tầng Backend / Repository.</span><b>Internal Data</b></div>
                <div><div class="dt-key"><code>Mask (Proxy/Decorator)</code></div><span>Mặt nạ đại diện cho một bản ghi Model. Mở quyền gọi các method an toàn qua <code>allow()</code>, chuyển đổi quan hệ liên kết qua <code>map()</code>, và thêm trường dẫn xuất qua <code>onLoaded()</code>.</span><b>Safe View Model</b></div>
                <div><div class="dt-key"><code>MaskCollection</code></div><span>Tập hợp bọc danh sách nhiều Mask bản ghi, hỗ trợ duyệt mảng, phân trang và tương thích hoàn hảo với JSON Serialization.</span><b>List Wrapper</b></div>
            </div>

            <p class="kicker"><span>02. VÒNG ĐỜI MASK</span> 4 Hook quan trọng</p>
            <h2>Chu kỳ khởi tạo và nạp dữ liệu của Mask.</h2>
            <p>Khi một Model được nạp vào Mask, chu trình xử lý diễn ra theo 4 bước tuần tự:</p>

            <div class="directive-table">
                <div><div class="dt-key"><code>init()</code></div><span>Chạy đầu tiên — nơi gọi <code>$this->allow(...)</code> để mở quyền truy cập method an toàn của Model, và <code>$this->map(...)</code> để định nghĩa Mask cho các quan hệ liên kết (Relations).</span><b>Bước 1</b></div>
                <div><div class="dt-key"><code>onBeforeLoadRelations()</code></div><span>Chạy trước khi nạp các quan hệ dữ liệu liên kết.</span><b>Bước 2</b></div>
                <div><div class="dt-key"><code>onLoaded()</code></div><span>Chạy sau khi dữ liệu Model và các relation đã được nạp xong — nơi tính toán trường dẫn xuất, format chuỗi, decode JSON metadata.</span><b>Bước 3</b></div>
                <div><div class="dt-key"><code>onCompleted() / __lock()</code></div><span>Chốt lại đối tượng và khoá bảo vệ (Lock). Không cho phép thay đổi dữ liệu sau bước này.</span><b>Bước 4</b></div>
            </div>

            <p class="kicker"><span>03. VÍ DỤ THỰC TẾ</span> Định nghĩa một Mask hoàn chỉnh</p>
            <h2>Cấu trúc của một lớp Mask trong Module.</h2>
            <p>Dưới đây là ví dụ thực tế của <code>PostMask</code> xử lý quan hệ Category, Author, Tags, Metadata và các hàm tính toán nghiệp vụ:</p>

            <code-window label="PHP" title="app/Modules/Posts/Masks/PostMask.php" lang="php">
@verbatim
namespace App\Modules\Posts\Masks;

use Saola\Core\Masks\Mask;
use App\Modules\Categories\Masks\CategoryMask;
use App\Modules\Users\Masks\AuthorMask;
use App\Modules\Tags\Masks\TagCollection;
use App\Modules\Comments\Masks\CommentCollection;
use App\Modules\Posts\Repositories\PostRepository;

class PostMask extends Mask
{
    public $meta = [];

    /**
     * 1. init(): Khai báo quyền truy cập và map quan hệ
     */
    protected function init()
    {
        // Cho phép View gọi trực tiếp các method an toàn từ Model
        $this->allow([
            'getViewUrl', 'getFullTitle', 'getSeoKeywords', 
            'getFeaturedImage', 'getThumbnail', 'timeAgo', 'dateFormat'
        ]);

        // Map các quan hệ (Eloquent Relations) sang Mask / Collection tương ứng
        $this->map([
            'category'        => CategoryMask::class,
            'author'          => AuthorMask::class,
            'tags'            => TagCollection::class,
            'comments'        => CommentCollection::class,
            'publishComments' => CommentCollection::class,
        ]);
    }

    /**
     * 2. onLoaded(): Xử lý sau khi dữ liệu & quan hệ đã nạp
     */
    protected function onLoaded()
    {
        $this->name = $this->title;

        // Xử lý metadata JSON nếu có
        if ($metadatas = $this->relation('metadatas')) {
            $jsf = $this->model->getJsonFields();
            foreach ($metadatas as $m) {
                $value = in_array($m->name, $jsf) ? json_decode($m->value, true) : $m->value;
                $this->meta[$m->name] = $value;
            }
        }

        // Tính toán các trường dẫn xuất
        $this->image_url = $this->getFeaturedImage();
        $this->reading_time = max(1, ceil(str_word_count(strip_tags($this->content ?? '')) / 200)) . ' phút đọc';
    }

    /**
     * 3. Các method nghiệp vụ tiện ích trực tiếp trên Mask
     */
    public function getRelated(int $limit = 6)
    {
        return app(PostRepository::class)
            ->mode('mask')
            ->where('id', '!=', $this->id)
            ->where('category_id', $this->category_id)
            ->limit($limit)
            ->get();
    }

    public function next()
    {
        return app(PostRepository::class)
            ->mode('mask')
            ->where('id', '>', $this->id)
            ->where('category_id', $this->category_id)
            ->orderBy('id', 'ASC')
            ->first();
    }
}
@endverbatim
            </code-window>

            <p class="ov-sub">Khai báo MaskCollection cho danh sách</p>
            <p>Khi truy vấn danh sách nhiều bài viết, <code>PostCollection</code> tự động quản lý từng phần tử dưới dạng <code>PostMask</code>:</p>

            <code-window label="PHP" title="app/Modules/Posts/Masks/PostCollection.php" lang="php">
@verbatim
namespace App\Modules\Posts\Masks;

use Saola\Core\Masks\MaskCollection;

class PostCollection extends MaskCollection
{
    // Chỉ định Mask đại diện cho mỗi phần tử
    protected $mask = PostMask::class;
}
@endverbatim
            </code-window>

            <p class="kicker"><span>04. TÍCH HỢP REPOSITORY</span> Chế độ mode('mask')</p>
            <h2>Khai báo và kích hoạt Mask trong Repository.</h2>
            <p>Repository quản lý việc chuyển đổi giữa Eloquent Model gốc và Mask thông qua thuộc tính <code>$maskClass</code> và phương thức <code>mode('mask')</code>:</p>

            <code-window label="PHP" title="app/Modules/Posts/Repositories/PostRepository.php" lang="php">
@verbatim
namespace App\Modules\Posts\Repositories;

use Saola\Core\Repositories\BaseRepository;
use App\Modules\Posts\Models\Post;
use App\Modules\Posts\Masks\PostMask;
use App\Modules\Posts\Masks\PostCollection;

class PostRepository extends BaseRepository
{
    /**
     * Khai báo Mask và Collection tương ứng cho Repository
     */
    protected $maskClass = PostMask::class;
    protected $maskCollectionClass = PostCollection::class;

    public function getModel(): string
    {
        return Post::class;
    }
}
@endverbatim
            </code-window>

            <p class="ov-sub">Cách Controller truy vấn và trả về Mask</p>
            <p>Trong Controller, chỉ cần kích hoạt <code>->mode('mask')</code> để mọi kết quả trả về đều là Mask an toàn sẵn sàng đưa sang View:</p>

            <code-window label="PHP" title="app/Modules/Posts/Http/Controllers/Web/PostController.php" lang="php">
@verbatim
namespace App\Modules\Posts\Http\Controllers\Web;

use App\Http\Controllers\WebController;
use App\Modules\Posts\Repositories\PostRepository;
use Illuminate\Http\Request;

class PostController extends WebController
{
    public function __construct(
        protected PostRepository $postRepository
    ) {
        // Kích hoạt mode mask cho toàn bộ repository trong controller
        $this->postRepository->mode('mask');
    }

    public function index()
    {
        // Trả về PostCollection chứa danh sách các PostMask
        $posts = $this->postRepository->paginate(12);

        return $this->response([
            'title' => 'Tin tức mới nhất',
            'posts' => $posts,
        ]);
    }

    public function detail(string $slug)
    {
        // Trả về một instance PostMask
        $post = $this->postRepository->detail(['slug' => $slug]);

        if (!$post) {
            return $this->view('errors.404');
        }

        return $this->response([
            'title' => $post->title,
            'post'  => $post,
        ]);
    }
}
@endverbatim
            </code-window>

            <p class="kicker"><span>05. TIÊU THỤ TRONG VIEW</span> Sử dụng Mask trong file .sao</p>
            <h2>Truy cập thuộc tính, quan hệ và gọi method trên View.</h2>
            <p>Do Mask hiện thực <code>ArrayAccess</code>, <code>Countable</code>, <code>IteratorAggregate</code> và <code>JsonSerializable</code>, template <code>.sao</code> có thể đọc dữ liệu và gọi hàm rất tự nhiên:</p>

            <code-window label="SAOLA" title="resources/saola/web/views/modules/posts/detail.sao" lang="html">
@verbatim
&#64;props({
    title: '',
    post: {}
})

&lt;template&gt;
    &#64;extends(__layout__ + "public")

    &#64;block('content')
        &lt;article class="post-detail"&gt;
            &lt;header&gt;
                &lt;h1&gt;&#123;&#123; post.title &#125;&#125;&lt;/h1&gt;
                
                &lt;div class="meta"&gt;
                    &lt;span&gt;Tác giả: &#123;&#123; post.author.name &#125;&#125;&lt;/span&gt;
                    &lt;span&gt;Chuyên mục: &#123;&#123; post.category.name &#125;&#125;&lt;/span&gt;
                    &lt;span&gt;&#123;&#123; post.reading_time &#125;&#125;&lt;/span&gt;
                    &lt;span&gt;Đăng &#123;&#123; post.timeAgo() &#125;&#125;&lt;/span&gt;
                &lt;/div&gt;
            &lt;/header&gt;

            &lt;div class="content"&gt;
                &#123;!! post.content !!&#125;
            &lt;/div&gt;

            &lt;!-- Lấy danh sách bài viết liên quan trực tiếp từ helper của Mask --&gt;
            &lt;section class="related"&gt;
                &lt;h3&gt;Bài viết cùng chuyên mục&lt;/h3&gt;
                &lt;div class="grid"&gt;
                    &#64;foreach(post.getRelated(4) as item)
                        &#64;key(item.id)
                        &lt;a href="&#123;&#123; item.getViewUrl() &#125;&#125;" class="card"&gt;
                            &lt;img src="&#123;&#123; item.image_url &#125;&#125;" alt="&#123;&#123; item.title &#125;&#125;" /&gt;
                            &lt;h4&gt;&#123;&#123; item.title &#125;&#125;&lt;/h4&gt;
                        &lt;/a&gt;
                    &#64;endforeach
                &lt;/div&gt;
            &lt;/section&gt;
        &lt;/article&gt;
    &#64;endblock
&lt;/template&gt;
@endverbatim
            </code-window>

            <div class="ov-note">
                <strong>Null-Safety với EmptyMask &amp; Nothing:</strong> Nếu quan hệ hoặc bản ghi không tồn tại (ví dụ <code>$post->author</code> là null), Mask tự động trả về <code>EmptyMask</code> hoặc <code>Nothing</code> thay vì <code>null</code>. Điều này giúp các biểu thức như <code>&#123;&#123; post.author.name &#125;&#125;</code> trên template không bao giờ bị crash với lỗi <em>"Call to a member function on null"</em>.
            </div>
        </div>

        <a class="doc-next" href="/docs/validator">
            <div><span>Tiếp theo</span><strong>Form Request &amp; Validation</strong></div>
            <span class="button button-primary">Đọc tiếp →</span>
        </a>
    @endblock
</template>
