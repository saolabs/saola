@states({ clientMode: 'browser' }: { clientMode: string })
@import('web.components.code-window')
<template>
    @extends(__layout__ + "docs")
    @section('meta:title', 'Response và Thương lượng Đầu ra - Saola Docs')
    @section('meta:description', 'Xử lý phản hồi và thương lượng nội dung (Content Negotiation) trong Saola: Tự động trả về HTML cho SSR hoặc JSON cho SPA và API.')
    @section('meta:keywords', 'saola response, content negotiation, ssr html, spa json, response factory')
    @block('doc')
        <header class="page-hero">
            <div>
                <p class="kicker"><span>11</span> BACKEND</p>
                <h1>Response và thương lượng đầu ra.</h1>
            </div>
            <div class="page-hero-aside">
                <p>Một controller phục vụ được cả trình duyệt lẫn API mà không rẽ nhánh: <code>$this-&gt;response()</code> tự quyết trả HTML hay JSON dựa trên chính request.</p>
            </div>
        </header>

        <div class="doc-body">
            <p class="kicker"><span>MỘT HÀM</span> Hai kiểu đầu ra</p>
            <h2>Controller không cần biết ai đang gọi.</h2>
            <p>Đây là lý do gần như mọi controller trong dự án chỉ có một dòng thân hàm. Cùng route đó, trình duyệt nhận trang đã render sẵn, còn <code>fetch</code> nhận JSON.</p>
            <code-window label="PHP" title="app/Modules/Roster/Http/Controllers/Web/RosterController.php" lang="php">
@verbatim
class RosterController extends WebController
{
    protected $module = 'roster';

    public function index()
    {
        return $this->response([]);
    }
}
@endverbatim
            </code-window>
            <div class="directive-table">
                <div><div class="dt-key">Trình duyệt</div><span>Accept là HTML → render Blade của route rồi trả trang</span><b>view</b></div>
                <div><div class="dt-key">Fetch / API</div><span>Accept là JSON, hoặc context <code>api</code> không có view → trả JSON</span><b>json</b></div>
            </div>

            <p class="kicker"><span>MINH HỌA TRỰC QUAN</span> Content Negotiation trong thực tế</p>
            <h2>Mô phỏng cơ chế phản hồi theo ngữ cảnh gọi.</h2>
            <p>Hãy bấm chuyển chế độ bên dưới để xem cách <code>$this->response($data)</code> tự động biến hoá payload phù hợp:</p>

            <div class="ov-card" style="margin-bottom: 2.5rem; border-color: var(--primary, #0284c7); padding: 1.5rem;">
                <div style="display: flex; gap: 0.5rem; margin-bottom: 1.25rem; flex-wrap: wrap;">
                    <button type="button" class="button button-sm" @class({'button-primary': clientMode === 'browser'}) @click(setClientMode('browser'))>
                        Trình duyệt (Initial Page Load / SSR)
                    </button>
                    <button type="button" class="button button-sm" @class({'button-primary': clientMode === 'spa'}) @click(setClientMode('spa'))>
                        SPA Client Fetch (Navigation)
                    </button>
                    <button type="button" class="button button-sm" @class({'button-primary': clientMode === 'api'}) @click(setClientMode('api'))>
                        API Client / Mobile App (forceJson)
                    </button>
                </div>

                @if(clientMode === 'browser')
                    <div style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">
                        <div style="color: #38bdf8; font-family: monospace; font-size: 0.85rem; margin-bottom: 0.5rem; font-weight: 600;">[REQUEST HEADERS TỪ BROWSER]</div>
                        <pre style="margin: 0; font-size: 0.82rem; color: #94a3b8; font-family: monospace; white-space: pre-wrap;">GET /products/42 HTTP/1.1
Host: saola.test
Accept: text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8
User-Agent: Mozilla/5.0 ... Chrome/128.0</pre>
                    </div>
                    <div style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 8px; padding: 1rem;">
                        <div style="color: #34d399; font-family: monospace; font-size: 0.85rem; margin-bottom: 0.5rem; font-weight: 600;">[RESPONSE TỪ SAOLA: 200 OK — Rendered HTML]</div>
                        <pre style="margin: 0; font-size: 0.82rem; color: #cbd5e1; font-family: monospace; white-space: pre-wrap;">HTTP/1.1 200 OK
Content-Type: text/html; charset=UTF-8

&lt;!DOCTYPE html&gt;
&lt;html lang="vi"&gt;
  &lt;head&gt;&lt;title&gt;Sản phẩm #42 - Saola Ecosystem&lt;/title&gt;&lt;/head&gt;
  &lt;body&gt;
    &lt;div id="app"&gt;
      &lt;!--s:v:web.products.show-s--&gt;
      &lt;div class="product-detail"&gt;
        &lt;h1&gt;Bàn phím cơ Saola Pro&lt;/h1&gt;
        &lt;span class="badge"&gt;120.00 USD&lt;/span&gt;
      &lt;/div&gt;
      &lt;!--s:v:web.products.show-e--&gt;
    &lt;/div&gt;
  &lt;/body&gt;
&lt;/html&gt;</pre>
                    </div>
                @elseif(clientMode === 'spa')
                    <div style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">
                        <div style="color: #38bdf8; font-family: monospace; font-size: 0.85rem; margin-bottom: 0.5rem; font-weight: 600;">[REQUEST HEADERS TỪ SPA ROUTER]</div>
                        <pre style="margin: 0; font-size: 0.82rem; color: #94a3b8; font-family: monospace; white-space: pre-wrap;">GET /products/42 HTTP/1.1
Host: saola.test
Accept: application/json
X-Requested-With: XMLHttpRequest
X-Saola-Navigation: true</pre>
                    </div>
                    <div style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 8px; padding: 1rem;">
                        <div style="color: #34d399; font-family: monospace; font-size: 0.85rem; margin-bottom: 0.5rem; font-weight: 600;">[RESPONSE TỪ SAOLA: 200 OK — JSON Data + View metadata]</div>
                        <pre style="margin: 0; font-size: 0.82rem; color: #cbd5e1; font-family: monospace; white-space: pre-wrap;">HTTP/1.1 200 OK
Content-Type: application/json; charset=UTF-8

{
  "code": 200,
  "view": "web.products.show",
  "data": {
    "item": {
      "id": 42,
      "title": "Bàn phím cơ Saola Pro",
      "price": 120.00
    }
  },
  "meta": {
    "title": "Sản phẩm #42 - Saola Ecosystem"
  }
}</pre>
                    </div>
                @else
                    <div style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">
                        <div style="color: #38bdf8; font-family: monospace; font-size: 0.85rem; margin-bottom: 0.5rem; font-weight: 600;">[REQUEST HEADERS TỪ API CLIENT]</div>
                        <pre style="margin: 0; font-size: 0.82rem; color: #94a3b8; font-family: monospace; white-space: pre-wrap;">GET /api/v1/products/42 HTTP/1.1
Host: saola.test
Accept: application/json
Authorization: Bearer saola_token_xyz</pre>
                    </div>
                    <div style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 8px; padding: 1rem;">
                        <div style="color: #34d399; font-family: monospace; font-size: 0.85rem; margin-bottom: 0.5rem; font-weight: 600;">[RESPONSE TỪ SAOLA: 200 OK — Pure JSON Payload]</div>
                        <pre style="margin: 0; font-size: 0.82rem; color: #cbd5e1; font-family: monospace; white-space: pre-wrap;">HTTP/1.1 200 OK
Content-Type: application/json; charset=UTF-8

{
  "code": 200,
  "message": "success",
  "data": {
    "item": {
      "id": 42,
      "title": "Bàn phím cơ Saola Pro",
      "price": 120.00
    }
  }
}</pre>
                    </div>
                @endif
            </div>

            <p class="kicker"><span>PHÂN GIẢI</span> View đến từ tên route</p>
            <h2>Không truyền đường dẫn thì nó tự tra.</h2>
            <p>Khi không đưa <code>$bladePath</code>, <code>response()</code> hỏi <code>ViewContextManager::routeToViewPathConfig()</code> xem route tên đó ứng với view nào trong context hiện tại. Nhờ vậy một method phục vụ được nhiều route.</p>
            <code-window label="PHP" title="app/Modules/Docs/.../DocsController.php" lang="php">
@verbatim
// 16 route /docs/* dùng chung đúng method này;
// view resolve theo route name web.docs.{slug}
public function page()
{
    return $this->response([]);
}
@endverbatim
            </code-window>
            <div class="ov-note">
                Vì view suy từ <strong>tên route</strong>, route có tham số (<code>/docs/{slug}</code>) sẽ không có view cố định — và router phía client cũng không dựng được bản đồ path → component cho nó. Đó là lý do tài liệu khai báo 16 route tĩnh thay vì một route tham số.
            </div>

            <p class="kicker"><span>THAM SỐ</span> Khi cần ép</p>
            <h2>Ba tham số, phần lớn thời gian chỉ dùng tham số đầu.</h2>
            <code-window label="PHP" title="Chữ ký" lang="php">
@verbatim
$this->response(array $data = [], ?string $bladePath = null, array $options = [])
@endverbatim
            </code-window>
            <div class="directive-table">
                <div><div class="dt-key"><code>$data</code></div><span>Dữ liệu đưa sang view, đồng thời là payload JSON</span><b>mảng</b></div>
                <div><div class="dt-key"><code>$bladePath</code></div><span>Chỉ định view thay vì để tra theo route name</span><b>chuỗi</b></div>
                <div><div class="dt-key"><code>status</code></div><span>Mã HTTP, mặc định 200</span><b>option</b></div>
                <div><div class="dt-key"><code>headers</code></div><span>Header thêm vào response</span><b>option</b></div>
                <div><div class="dt-key"><code>forceJson</code></div><span>Luôn trả JSON dù request muốn HTML</span><b>option</b></div>
                <div><div class="dt-key"><code>forceView</code></div><span>Luôn render view</span><b>option</b></div>
                <div><div class="dt-key"><code>includeView</code></div><span>Kèm thông tin view vào payload JSON — router client dùng để biết cần nạp component nào</span><b>option</b></div>
                <div><div class="dt-key"><code>jsonOptions</code></div><span>Cờ cho <code>json_encode</code>, mặc định <code>JSON_UNESCAPED_UNICODE</code></span><b>option</b></div>
            </div>
            <p><code>wantsJsonResponse()</code> là nơi quyết định, và <code>autoResponse()</code> dùng khi bạn muốn tự gọi lại logic thương lượng đó ở chỗ khác.</p>

            <p class="ov-note">
                Đừng đẩy model thô vào <code>$data</code>: nó vừa là dữ liệu view vừa là payload JSON, nên mọi cột của bảng sẽ lộ ra API. Bọc <a href="/docs/mask">Mask</a> trước.
            </p>
        </div>
    @endblock
</template>

