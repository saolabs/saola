@import('web.components.code-block')
@import('web.modules.roster.item' as rosteritem)
@states({
    ids: [],
    records: {},
    editing: {},
    lastSync: '',
    syncError: '',
    creating: false,
    fName: '',
    fEmail: '',
    fGender: 'other',
    fBirthdate: ''
}: {ids: string[]; records: Record<string, RosterRecord | null>; editing: Record<string, boolean>; lastSync: string; syncError: string; creating: boolean; fName: string; fEmail: string; fGender: string; fBirthdate: string})

<template>
    @extends(__layout__ + 'lab')
    @section('meta:title', 'Roster CRUD & Concurrent Sync Demo - Saola Lab')
    @section('meta:description', 'Ứng dụng mẫu Roster quản lý người dùng qua API: Đồng bộ ngầm định kỳ, biên tập đồng thời với state cô lập ở component con không bị gián đoạn.')
    @section('meta:keywords', 'roster demo, concurrent editing, saola crud, api sync, component state isolation')

    @block('main')
        <div class="rs-page">
            <p class="kicker"><span>ỨNG DỤNG THẬT · ĐỒNG BỘ CONCURRENT</span></p>
            <div class="workspace-topbar">
                <div>
                    <h1>Roster — CRUD qua API.</h1>
                    <p class="lab-lead">Danh sách đồng bộ ngầm định kỳ 30 giây, hỗ trợ concurrent editing: view con giữ form nháp riêng không bị mất khi view cha refetch.</p>
                </div>
                <div class="completion-ring">
                    <strong>{{ ids.length }}</strong><span>users</span>
                </div>
            </div>

            <p class="rs-lead">Danh sách tự kéo lại mỗi 30 giây. Mỗi hàng có form sửa riêng — nếu người khác sửa hoặc xoá đúng bản ghi bạn đang mở, bản nháp của bạn được giữ nguyên và bạn được hỏi trước khi mất bất cứ thứ gì.</p>

            <dl class="rs-stats">
                <div class="rs-stat">
                    <dt>Người dùng</dt>
                    <dd>{{ ids.length }}</dd>
                </div>
                <div class="rs-stat">
                    <dt>Nhịp đồng bộ</dt>
                    <dd>30 <small>giây</small></dd>
                </div>
                <div class="rs-stat">
                    <dt>Đồng bộ lần cuối</dt>
                    @if(lastSync === '')
                        <dd><small>chưa chạy</small></dd>
                    @else
                        <dd>{{ lastSync }}</dd>
                    @endif
                </div>
            </dl>

            @if(syncError !== '')
                <p class="rs-alert rs-alert--danger rs-alert--error">{{ syncError }}</p>
            @endif

            <section class="rs-card">
                <div class="rs-card-head">
                    <h2>Thêm người dùng</h2>
                    <p>Bản ghi mới được server cấp uuid và mốc version.</p>
                </div>
                <form class="rs-form-grid" @submit(createUser(event))>
                    <label class="rs-field">
                        <span>Họ tên</span>
                        <input type="text" placeholder="Nguyễn Văn A" @bind(fName)>
                    </label>
                    <label class="rs-field">
                        <span>Email</span>
                        <input type="email" placeholder="a@saola.dev" @bind(fEmail)>
                    </label>
                    <label class="rs-field">
                        <span>Giới tính</span>
                        <select @bind(fGender)>
                            <option value="male">male</option>
                            <option value="female">female</option>
                            <option value="other">other</option>
                        </select>
                    </label>
                    <label class="rs-field">
                        <span>Ngày sinh</span>
                        <input type="date" @bind(fBirthdate)>
                    </label>
                    <div class="rs-form-actions">
                        <button type="submit" class="rs-btn rs-btn-primary" @disabled(creating)>Thêm người dùng</button>
                    </div>
                </form>
            </section>

            <div class="rs-list-head">
                <h2>Bản ghi</h2>
                <div class="rs-list-tools">
                    <span class="rs-pulse"><span class="rs-pulse-dot"></span> Tự đồng bộ mỗi 30 giây</span>
                    <button type="button" class="rs-btn rs-btn-sm rs-btn-ghost" @click(load())>Đồng bộ ngay</button>
                </div>
            </div>

            <div class="rs-list">
                @foreach(ids as id)
                    @key(id)
                    <div class="rs-slot">
                        {{-- record đổi ref ⇒ Component đẩy prop mới vào ĐÚNG instance con
                             đang sống, nên state form của nó không bị thổi bay. --}}
                        <rosteritem :uid="id" :record="records[id] ?? null" />
                    </div>
                @endforeach
            </div>

            @if(ids.length === 0)
                <p class="rs-empty">Chưa có ai trong danh sách. Thêm người dùng đầu tiên ở form phía trên.</p>
            @endif
        </div>
    @endblock

    @block('source')
        <h2 class="lab-source-title">Code của demo này</h2>
        <p class="lab-source-note">Parent quản lý danh sách ID, view con giữ form sửa và state riêng.</p>
        <code-block lang="sao">
@verbatim
@import('web.modules.roster.item' as rosteritem)
@states({ ids: [], records: {} })

<template>
    <div class="rs-list">
        @foreach(ids as id)
            @key(id)
            <div class="rs-slot">
                {{-- Prop mới truyền vào đúng instance con đang sống --}}
                <rosteritem :uid="id" :record="records[id] ?? null" />
            </div>
        @endforeach
    </div>
</template>
@endverbatim
        </code-block>
    @endblock

    @block('aside')
        <h2>Trang này kiểm chứng cái gì.</h2>
        <ul class="check-list">
            <li><strong>ForeachSlotCache &amp; Identity:</strong> Vòng lặp dựa trên <code>ids</code> với <code>@key(id)</code>. Khi bấm "Đồng bộ ngay", server trả về tham chiếu object mới nhưng runtime tái dùng đúng component con tương ứng.</li>
            <li><strong>Bảo toàn bản nháp (Draft Preservation):</strong> Mỗi hàng nhúng một view con mang <code>@states</code> form riêng. Dù cha có fetch dữ liệu mới, form đang mở dở của con không bị reset.</li>
            <li><strong>Sự kiện vòng đời:</strong> Tự động kích hoạt timer polling 30s trong <code>started()</code> và dọn dẹp trong <code>stopped()</code> / <code>destroyed()</code>.</li>
            <li><strong>Optimistic Update &amp; Conflict Handling:</strong> Cha lắng nghe sự kiện <code>roster:editing</code> để không bao giờ xoá nhầm bản ghi mà người dùng đang thao tác dở.</li>
        </ul>
    @endblock
</template>

<script setup lang="ts">
    import type { RosterRecord } from '@web/app/services/DemoTypes';
    import { errorMessage } from '@web/app/services/Errors';
    const API = '/api/api/roster';

    let _timer = undefined as ReturnType<typeof setInterval> | undefined;
    let _off = [] as (() => void)[];

    // ─── Lifecycle ──────────────────────────────────────────
    // started/stopped: kích hoạt & huỷ kích hoạt bình thường.
    // resumed/paused : quay lại & rời PageCache (DOM còn, view ngủ).
    function started() { activate(); }
    function resumed() { activate(); }
    function stopped() { deactivate(); }
    function paused() { deactivate(); }
    function destroyed() { deactivate(); }

    function activate() {
        if (_timer) return;
        _timer = setInterval(() => load(), 30000);
        _off = [
            // Hàng con báo lên "tôi đang mở form" — parent cần biết để KHÔNG
            // gỡ hàng khi server đã xoá bản ghi đó.
            App.Event.on('roster:editing', (uid: string, on: boolean) => {
                const next = { ...editing };
                if (on) next[uid] = true; else delete next[uid];
                setEditing(next);
            }),
            // Bản ghi vừa lưu do chính hàng con đẩy lên — gộp ngay để hàng
            // không hiện dữ liệu cũ trong lúc chờ lượt fetch kế tiếp.
            App.Event.on('roster:record', (rec: RosterRecord) => {
                if (!rec || !rec.uuid) return;
                setRecords({ ...records, [rec.uuid]: rec });
                if (!ids.includes(rec.uuid)) setIds([...ids, rec.uuid]);
            }),
            App.Event.on('roster:refresh', () => load())
        ];
        load();
    }

    function deactivate() {
        clearInterval(_timer);
        _timer = undefined;
        (_off || []).forEach(off => off());
        _off = [];
    }

    // ─── Fetch ──────────────────────────────────────────────
    async function load() {
        try {
            const res = await App.Http.get(API);
            setSyncError('');
            applyServer(res.data.data || []);
        } catch (e) {
            setSyncError('Không tải được danh sách: ' + errorMessage(e));
        }
    }

    /**
     * Hoà bản server vào state hiện tại.
     *
     * Hai quy tắc giữ cho form đang mở không bị đập:
     *   1. updated_at không đổi ⇒ GIỮ NGUYÊN object ref cũ. Ref không đổi
     *      thì Component không đẩy prop, hàng đó không render lại.
     *   2. Bản ghi biến mất mà hàng đó đang được sửa ⇒ giữ id lại trong
     *      danh sách và đặt record = null. null chính là tín hiệu "bia mộ"
     *      để item view hiện khối "người khác vừa xoá".
     */
    function applyServer(list: RosterRecord[]) {
        const byId: Record<string, RosterRecord> = {};
        for (const u of list) byId[u.uuid] = u;

        const nextIds = [];
        for (const id of ids) {
            if (byId[id] || editing[id]) nextIds.push(id);
        }
        for (const u of list) {
            if (!ids.includes(u.uuid)) nextIds.push(u.uuid);
        }

        const nextRecords: Record<string, RosterRecord | null> = {};
        let changed = nextIds.length !== ids.length;
        for (let i = 0; i < nextIds.length; i++) {
            const id = nextIds[i];
            if (id !== ids[i]) changed = true;

            const fresh = byId[id] || null;
            const cur = records[id];
            const same = fresh && cur && cur.updated_at === fresh.updated_at;
            nextRecords[id] = same ? cur : fresh;
            if (nextRecords[id] !== cur) changed = true;
        }

        if (changed) {
            setIds(nextIds);
            setRecords(nextRecords);
        }
        setLastSync(new Date().toLocaleTimeString());
    }

    // ─── Create ─────────────────────────────────────────────
    async function createUser(event: Event) {
        event.preventDefault();
        if (creating) return;
        setCreating(true);
        try {
            await App.Http.post(API, {
                name: fName,
                email: fEmail,
                gender: fGender,
                birthdate: fBirthdate
            });
            setFName('');
            setFEmail('');
            setFBirthdate('');
            setSyncError('');
            await load();
        } catch (e) {
            setSyncError('Không tạo được user: ' + errorMessage(e));
        } finally {
            setCreating(false);
        }
    }
</script>

<link rel="stylesheet" href="/static/saola/roster.css">
