                            <td><span class="cmp-no">Bắt buộc</span></td>
                        </tr>
                        <tr>
                            <th scope="row">Đa mặt tiền, tách bundle</th>
                            <td class="col-sao"><span class="cmp-yes">Sẵn bốn context</span></td>
                            <td>Tự dựng</td>
                            <td>Tự dựng</td>
                            <td>Tự dựng</td>
                            <td>Tự dựng</td>
                        </tr>
                        <tr>
                            <th scope="row">Vòng đời view có contract</th>
                            <td class="col-sao">Bảy trạng thái, dọn theo ref-count</td>
                            <td>Không có</td>
                            <td>Theo component phía server</td>
                            <td>Theo framework JavaScript</td>
                            <td>Theo framework JavaScript</td>
                        </tr>
                        <tr>
                            <th scope="row">Độ chín và cộng đồng</th>
                            <td class="col-sao"><span class="cmp-no">Đang dựng nền</span></td>
