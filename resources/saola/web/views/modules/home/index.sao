@states({
    selectedSignal: 'hydration',
    email: '',
    joined: false
})

<template>
    @extends(__layout__ + "public")
    @block('content')
        <section class="hero-grid">
            <div class="hero-copy">
                <p class="eyebrow"><span>01</span> A calmer way to ship</p>
                <h1>One view.<br><em>Every surface.</em></h1>
                <p class="hero-lead">Saola keeps Laravel and Blade in charge of the first response, then hydrates the exact same view into a fast, stateful SPA.</p>
                <div class="hero-actions">
                    <a class="button button-primary" href="/todo-list">Try the workspace <span>→</span></a>
                    <a class="text-link" href="/about">Read our approach <span>↗</span></a>
                </div>
            </div>
            <div class="route-card" aria-label="Saola render route">
                <div class="route-card-head"><span>LIVE ROUTE</span><strong>/home</strong></div>
                <div class="route-line">
                    <button @class(['route-node', 'active': selectedSignal === 'blade']) @click(setSelectedSignal('blade'))><span>1</span><strong>Blade</strong><small>server response</small></button>
                    <button @class(['route-node', 'active': selectedSignal === 'hydration']) @click(setSelectedSignal('hydration'))><span>2</span><strong>Hydrate</strong><small>bind existing DOM</small></button>
                    <button @class(['route-node', 'active': selectedSignal === 'spa']) @click(setSelectedSignal('spa'))><span>3</span><strong>SPA</strong><small>client navigation</small></button>
                </div>
                <div class="signal-readout">
                    @if(selectedSignal === 'blade')
                        <p><strong>Server-first</strong> — HTML remains useful before JavaScript starts.</p>
                    @elseif(selectedSignal === 'spa')
                        <p><strong>Navigation-ready</strong> — only the changing view tree is replaced.</p>
                    @else
                        <p><strong>Hydration-safe</strong> — events and state attach to the DOM Blade already rendered.</p>
                    @endif
                </div>
            </div>
        </section>

        <section class="proof-strip">
            <p>BUILT FOR REAL APPLICATIONS</p>
            <div><strong>01</strong><span>Laravel routes</span></div>
            <div><strong>02</strong><span>Blade fallback</span></div>
            <div><strong>03</strong><span>Scoped assets</span></div>
            <div><strong>04</strong><span>Reactive state</span></div>
        </section>

        <section class="feature-section">
            <div class="section-heading">
                <p class="eyebrow"><span>02</span> The useful parts</p>
                <h2>Less framework<br>between intent and result.</h2>
            </div>
            <div class="feature-list">
                <article><span>01</span><h3>Render once</h3><p>The same `.sao` source produces server Blade and the client view contract.</p></article>
                <article><span>02</span><h3>Keep context</h3><p>Shared layouts survive route changes while page state follows a clear lifecycle.</p></article>
                <article><span>03</span><h3>Load precisely</h3><p>Global assets deduplicate; scoped styles stay attached to their owning view.</p></article>
            </div>
        </section>

        <section class="newsletter-panel">
            <div><p class="eyebrow"><span>03</span> Product notes</p><h2>Follow the build,<br>without the noise.</h2></div>
            <form class="newsletter-form" @submit(joinWaitlist(event))>
                @if(joined)
                    <div class="success-note"><span>✓</span><p><strong>You're on the list.</strong><br>We will write only when something useful ships.</p></div>
                @else
                    <label for="home-email">Work email</label>
                    <div><input id="home-email" type="email" placeholder="you@company.com" @bind(email) required><button type="submit">Join <span>→</span></button></div>
                    <small>No campaigns. Just meaningful release notes.</small>
                @endif
            </form>
        </section>
    @endblock
</template>

<script setup lang="ts">
    export default {
        name: 'HomePage',
        joinWaitlist(event) {
            event.preventDefault();
            if (email.trim()) setJoined(true);
        }
    };
</script>

<style scoped>
    .hero-copy h1 em { color: var(--cobalt); font-style: normal; }
    .route-node.active { transform: translateX(8px); }
</style>
