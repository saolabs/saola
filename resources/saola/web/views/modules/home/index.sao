@states({
    selectedSignal: 'hydration',
    email: '',
    joined: false
})

<template>
    @extends(__layout__ + "public")
    @block('content')
        <section class="hero-grid hero-studio" id="hero-section">
            <div class="hero-copy">
                <p class="hero-eyebrow">Nền tảng SPA thế hệ mới cho Laravel</p>
                <h1>Viết một lần.<br><em>Vận hành mọi nơi.</em></h1>
                <p class="hero-lead">Saola giữ Laravel và Blade cho phản hồi đầu tiên, sau đó hydrate chính xác view đó thành một SPA nhanh, reactive và an toàn.</p>
                <div class="hero-actions">
                    <a class="button button-primary" href="/todo-list">Trải nghiệm demo <span>→</span></a>
                    <a class="button button-secondary" href="/about">Khám phá kiến trúc</a>
                </div>
                <div class="hero-proof-row" aria-label="Saola capabilities">
                    <span>✓ SSR bằng Blade</span>
                    <span>✓ Hydration không duplicate</span>
                    <span>✓ Reactive theo state</span>
                </div>
            </div>
            <div class="route-card" aria-label="Saola render route">
                <div class="route-card-head">
                    <div><span class="runtime-dot"></span><strong>Runtime overview</strong></div>
                    <span class="live-badge">Live · /home</span>
                </div>
                <div class="runtime-metrics">
                    <div><small>Render source</small><strong>1 view</strong><span>.sao</span></div>
                    <div><small>Current phase</small><strong>Hydrate</strong><span>DOM reuse</span></div>
                    <div><small>Listeners</small><strong>1×</strong><span>deduplicated</span></div>
                </div>
                <div class="route-line" role="group" aria-label="Chọn giai đoạn render">
                    <button @class(['route-node', 'active': selectedSignal === 'blade']) @click(setSelectedSignal('blade')) aria-label="Xem giai đoạn Blade"><span>01</span><strong>Blade</strong><small>server response</small></button>
                    <button @class(['route-node', 'active': selectedSignal === 'hydration']) @click(setSelectedSignal('hydration')) aria-label="Xem giai đoạn hydration"><span>02</span><strong>Hydrate</strong><small>bind existing DOM</small></button>
                    <button @class(['route-node', 'active': selectedSignal === 'spa']) @click(setSelectedSignal('spa')) aria-label="Xem giai đoạn SPA"><span>03</span><strong>SPA</strong><small>client navigation</small></button>
                </div>
                <div class="signal-readout">
                    @if(selectedSignal === 'blade')
                        <p><strong>Server-first</strong><span>HTML có nội dung ngay cả trước khi JavaScript khởi chạy.</span></p>
                    @elseif(selectedSignal === 'spa')
                        <p><strong>Navigation-ready</strong><span>Chỉ nhánh view thay đổi được cập nhật, layout dùng lại.</span></p>
                    @else
                        <p><strong>Hydration-safe</strong><span>State và event gắn vào DOM có sẵn, không nhân đôi listener.</span></p>
                    @endif
                </div>
            </div>
        </section>

        <section class="proof-strip">
            <p>NỀN TẢNG CHO ỨNG DỤNG THỰC TẾ</p>
            <div><strong>01</strong><span>Laravel routes</span></div>
            <div><strong>02</strong><span>Blade fallback</span></div>
            <div><strong>03</strong><span>Scoped assets</span></div>
            <div><strong>04</strong><span>Reactive state</span></div>
        </section>

        <section class="feature-section" id="workflow">
            <div class="section-heading">
                <p class="eyebrow"><span>Workflow</span> Từ route đến tương tác</p>
                <h2>Một quy trình.<br>Không có bước thừa.</h2>
            </div>
            <div class="feature-list">
                <article><span>01</span><h3>Render một nguồn</h3><p>Cùng một file `.sao` sinh Blade phía server và view contract phía client.</p></article>
                <article><span>02</span><h3>Hydrate DOM có sẵn</h3><p>Element được đối chiếu theo ID ổn định; attributes và events được reconcile thay vì gắn chồng.</p></article>
                <article><span>03</span><h3>Reactive đúng phạm vi</h3><p>State chỉ cập nhật nhánh phụ thuộc, đồng thời cleanup resource khi view bị hủy.</p></article>
            </div>
        </section>

        <section class="newsletter-panel">
            <div><p class="eyebrow"><span>Release notes</span> Theo dõi Saola</p><h2>Nhận cập nhật.<br>Không nhận spam.</h2></div>
            <form class="newsletter-form" @submit(joinWaitlist(event))>
                @if(joined)
                    <div class="success-note"><span>✓</span><p><strong>Đã ghi nhận email.</strong><br>Saola chỉ gửi khi có bản phát hành đáng chú ý.</p></div>
                @else
                    <label for="home-email">Email công việc</label>
                    <div><input id="home-email" type="email" placeholder="you@company.com" @bind(email) required><button type="submit">Join <span>→</span></button></div>
                    <small>Chỉ có release notes và cập nhật kỹ thuật quan trọng.</small>
                @endif
            </form>
        </section>
    @endblock
</template>

<script setup lang="ts">
    export default {
        name: 'HomePage',
        joinWaitlist(event) {
            event.preventDefault();
            if (email.trim()) setJoined(true);
        }
    };
</script>

<style scoped>
    .hero-copy h1 em { color: var(--cobalt); font-style: normal; }
    .route-node.active { isolation: isolate; }
</style>
