@import('web.components.code-block')
@vars(initialTodos: Todo[] = [], initialActiveCount = 0, initialCompletedCount = 0)
@await
@states({
    todos: initialTodos,
    newTodo: '',
    filter: 'all',
    activeCount: initialActiveCount,
    completedCount: initialCompletedCount,
    busy: false,
    syncError: ''
}: {todos: Todo[]; newTodo: string; filter: string; activeCount: number; completedCount: number; busy: boolean; syncError: string})

<template>
    @extends(__layout__ + 'lab')
    @section('meta:title', 'Todo App Demo - State Cục bộ & Phản ứng Tức thì | Saola')
    @section('meta:description', 'Trải nghiệm ứng dụng Todo mẫu xây dựng trên Saola: State cục bộ ở client instance, cập nhật tức thì với @bind, giữ nguyên qua điều hướng back/forward.')
    @section('meta:keywords', 'saola todo demo, quan ly cong viec, reactive state, bind directive, pagecache')
    @block('main')
        <p class="kicker"><span>ỨNG DỤNG THẬT · STATE CỤC BỘ</span></p>
        <div class="workspace-topbar">
            <div>
                <h1>Todo — State cục bộ.</h1>
                <p class="lab-lead">State nằm trọn vẹn ở client instance, cập nhật tức thì với <code>&#64;bind</code> và giữ nguyên qua điều hướng back/forward nhờ PageCache.</p>
            </div>
            <div class="completion-ring">
                <strong>{{ completedCount }}/{{ todos.length }}</strong><span>complete</span>
            </div>
        </div>

        <section class="todo-board">
            @if(syncError !== '')
                <p role="alert">{{ syncError }}</p>
            @endif
            <form class="todo-entry" @submit(addTodo(event))>
                <label for="new-task">Add one clear next step</label>
                <div>
                    <input id="new-task" type="text" maxlength="500" placeholder="What needs your attention?" @bind(newTodo)>
                    <button type="submit" @disabled(busy)>Add task <span>+</span></button>
                </div>
            </form>
            <div class="todo-toolbar">
                <div>
                    <button @class({'active': filter === 'all'}) @click(setFilter('all'))>All <span>{{ todos.length }}</span></button>
                    <button @class({'active': filter === 'active'}) @click(setFilter('active'))>Active <span>{{ activeCount }}</span></button>
                    <button @class({'active': filter === 'done'}) @click(setFilter('done'))>Done <span>{{ completedCount }}</span></button>
                </div>
                <button class="clear-button" @disabled(busy) @click(load())>Refresh list</button>
                <button class="clear-button" @disabled(busy || completedCount === 0) @click(clearCompleted())>Clear completed</button>
            </div>
            <div class="todo-list">
                @if(todos.length === 0)
                    <div class="empty-state">
                        <span>○</span>
                        <h2>Your queue is clear.</h2>
                        <p>Add one meaningful task above.</p>
                    </div>
                @else
                    @foreach(todos as todo)
                        @key(todo['id'])
                        @if(filter === 'all' || (filter === 'active' && !todo['completed']) || (filter === 'done' && todo['completed']))
                            <article @class({'todo-row', 'completed': todo['completed']})>
                                <button class="todo-check" @disabled(busy) @click(toggleTodo(todo['id'])) aria-label="Toggle task">
                                    @if(todo['completed'])
                                        ✓
                                    @endif
                                </button>
                                <div><strong>{{ todo['text'] }}</strong><small>SAOLA DEMO · TASK {{ todo['id'] }}</small></div>
                                <button class="todo-delete" @disabled(busy) @click(deleteTodo(todo['id'])) aria-label="Delete task">×</button>
                            </article>
                        @endif
                    @endforeach
                @endif
            </div>
            <footer class="todo-summary"><p><span>{{ activeCount }}</span> items still need attention.</p><a href="/about">Why Saola handles this differently →</a></footer>
        </section>
    @endblock

    @block('source')
        <h2 class="lab-source-title">Code của demo này</h2>
        <p class="lab-source-note">Tương tác hai chiều, cập nhật lạc quan và quản lý danh sách có khoá.</p>
        <code-block lang="sao">
@verbatim
&#64;vars(initialTodos: Todo[] = [])
&#64;await
&#64;states({
    todos: initialTodos,
    newTodo: '',
    filter: 'all'
})

&lt;template&gt;
    &lt;form &#64;submit(addTodo(event))&gt;
        &lt;input type="text" &#64;bind(newTodo)&gt;
        &lt;button type="submit"&gt;Add task +&lt;/button&gt;
    &lt;/form&gt;

    &#64;foreach(todos as todo)
        &#64;key(todo['id'])
        &lt;article &#64;class({'completed': todo['completed']})&gt;
            &lt;button &#64;click(toggleTodo(todo['id']))&gt;✓&lt;/button&gt;
            &lt;strong&gt;{{ todo['text'] }}&lt;/strong&gt;
            &lt;button &#64;click(deleteTodo(todo['id']))&gt;×&lt;/button&gt;
        &lt;/article&gt;
    &#64;endforeach
&lt;/template&gt;
@endverbatim
        </code-block>
    @endblock

    @block('aside')
        <h2>Trang này kiểm chứng cái gì.</h2>
        <ul class="check-list">
            <li><strong>Nạp bất đồng bộ với <code>&#64;await</code>:</strong> Lần đầu tải trang SSR trả về HTML đầy đủ từ cơ sở dữ liệu. Khi điều hướng SPA, client gọi API lấy JSON và hydrate vào view.</li>
            <li><strong>Two-way binding (<code>&#64;bind</code>):</strong> Ô nhập gắn trực tiếp với state <code>newTodo</code>, tự đồng bộ khi gõ.</li>
            <li><strong>Danh sách có khoá (<code>&#64;key(todo['id'])</code>):</strong> Thêm/xóa task chỉ thay đổi đúng DOM node tương ứng, không dựng lại cả danh sách.</li>
            <li><strong>Lưu trữ qua PageCache:</strong> Khi điều hướng sang trang khác rồi bấm Back, trạng thái danh sách và form đang gõ dở vẫn được bảo toàn nguyên vẹn.</li>
        </ul>
    @endblock
</template>

<script setup lang="ts">
    import type { Todo } from '@web/app/services/DemoTypes';
    import type { HttpResponse } from '@saolabs/client';
    import { errorMessage } from '@web/app/services/Errors';
    const URL = '/todo-list';

    // @await handles first load; a cached page refreshes when resumed.
    function resumed() { load(); }

    function requestOptions() {
        return {
            headers: {
                Accept: 'application/json',
                'X-Sao-Response': 'json',
                'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || ''
            }
        };
    }

    async function sync(request: () => Promise<HttpResponse<{data: {initialTodos: Todo[]; initialActiveCount: number; initialCompletedCount: number}}>>) {
        if (busy) return false;
        setBusy(true);
        setSyncError('');
        try {
            const response = await request();
            const data = response.data.data;
            setTodos(data.initialTodos);
            setActiveCount(data.initialActiveCount);
            setCompletedCount(data.initialCompletedCount);
            return true;
        } catch (error) {
            setSyncError('Could not sync tasks: ' + errorMessage(error));
            return false;
        } finally {
            setBusy(false);
        }
    }

    async function load() {
        return sync(() => App.Http.get(URL, null, requestOptions()));
    }

    async function addTodo(event: Event) {
        event.preventDefault();
        const text = newTodo.trim();
        if (!text) return;
        const saved = await sync(() => App.Http.post(URL, { text }, requestOptions()));
        if (saved && newTodo.trim() === text) setNewTodo('');
    }

    async function toggleTodo(id: number) {
        const todo = todos.find(item => item.id === id);
        if (!todo) return;
        return sync(() => App.Http.put(URL + '/' + id, { completed: !todo.completed }, requestOptions()));
    }

    async function deleteTodo(id: number) {
        return sync(() => App.Http.delete(URL + '/' + id, requestOptions()));
    }

    async function clearCompleted() {
        return sync(() => App.Http.delete(URL + '/completed', requestOptions()));
    }
</script>

<style scoped>
    .todo-row.completed strong { text-decoration: line-through; color: #79808b; }
    .todo-row.completed .todo-check { background: var(--river); border-color: var(--river); color: white; }
</style>
