@states({
    name: '',
    email: '',
    topic: 'Architecture review',
    message: '',
    messageLength: 0,
    attempted: false,
    sent: false
})

<template>
    @extends(__layout__ + "public")
    @block('content')
        <section class="contact-grid">
            <div class="contact-aside">
                <p class="eyebrow"><span>01</span> Contact</p>
                <h1>Bring us the<br><em>difficult part.</em></h1>
                <p>Tell us where your Laravel application is fighting the frontend. This form is deliberately client-only for the demo.</p>
                <div class="contact-meta"><span>RESPONSE WINDOW</span><strong>Usually within 2 working days</strong><span>BASED IN</span><strong>Ho Chi Minh City · Remote worldwide</strong></div>
            </div>
            <form class="contact-form" @submit(sendContact(event))>
                @if(sent)
                    <div class="contact-success"><span>✓</span><h2>Message prepared.</h2><p>The demo stopped before a network request. In production, this is where an API action would take over.</p><button type="button" class="text-link" @click(resetForm())>Write another message →</button></div>
                @else
                    <div class="field-row"><label><span>Your name</span><input type="text" placeholder="Nguyen An" @bind(name)></label><label><span>Email</span><input type="email" placeholder="an@company.com" @bind(email)></label></div>
                    @if(attempted && (!name.trim() || !email.trim()))
                        <p class="form-error">Please add both your name and email.</p>
                    @endif
                    <label><span>What should we discuss?</span><select @bind(topic)><option>Architecture review</option><option>Hydration migration</option><option>Compiler integration</option><option>Performance audit</option></select></label>
                    <label><span>Context</span><textarea maxlength="500" placeholder="What is the application doing today, and where does it become difficult?" @bind(message) @input(trackLength(event))></textarea><small>{{ messageLength }} / 500</small></label>
                    @if(attempted && messageLength < 12)
                        <p class="form-error">Give us at least 12 characters of context.</p>
                    @endif
                    <button type="submit" class="button button-primary">Prepare message <span>→</span></button>
                @endif
            </form>
        </section>
    @endblock
</template>

<script setup lang="ts">
    export default {
        name: 'ContactPage',
        trackLength(event) {
            // .length phải nằm trong <script setup>: trong directive nó bị
            // preprocessor đổi sang count() của PHP rồi lọt sang đầu ra JS.
            setMessageLength(event.target.value.length);
        },
        sendContact(event) {
            event.preventDefault();
            setAttempted(true);
            if (name.trim() && email.trim() && message.trim().length >= 12) setSent(true);
        },
        resetForm() {
            setName(''); setEmail(''); setMessage(''); setMessageLength(0); setAttempted(false); setSent(false);
        }
    };
</script>

<style scoped>
    .contact-aside h1 em { color: var(--cobalt); font-style: normal; }
</style>
