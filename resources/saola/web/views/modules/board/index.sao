@import('web.modules.board.card' as boardcard)

@vars(columns: BoardColumn[] = [])

{{-- Dữ liệu tới từ controller. Không có @await thì điều hướng SPA dựng view
     KHI CHƯA có dữ liệu: mọi @foreach ra rỗng, chỉ tải thẳng URL mới đúng.
     Cổng parity SSR↔CSR bắt được đúng lỗi này. --}}
@await

@states({
    board: columns,
    dragId: 0,
    overColumn: '',
    busy: false,
    note: '',
    error: '',
    editingId: 0,
    draftText: ''
}: {board: BoardColumn[]; dragId: number; overColumn: string; busy: boolean; note: string; error: string; editingId: number; draftText: string})

<template>
    @extends(__layout__ + 'lab')

    @block('main')
        <p class="kicker"><span>ỨNG DỤNG THẬT · KÉO THẢ</span></p>
        <h1>Bảng Kanban.</h1>
        <p class="kb-lead">
            Kéo một thẻ sang cột khác. Khoá của thẻ <strong>di chuyển giữa hai vùng
            <code>&#64;foreach</code> khác nhau</strong> — ca khó nhất của danh sách có khoá.
        </p>

        <form class="kb-new" @submit(addCard(event))>
            <input type="text" maxlength="120" placeholder="Thêm thẻ vào cột Cần làm" @bind(note) aria-label="Tiêu đề thẻ mới">
            <button type="submit" class="kb-mini" @disabled(busy || note.trim() === '')>Thêm</button>
        </form>

        @if(error !== '')
            <p class="kb-error" role="alert">{{ error }}</p>
        @endif

        <div class="kb-board">
            @foreach(board as col)
                @key(col['key'])
                <section @class({'kb-col', 'is-over': overColumn === col['key']})
                         :data-col="col['key']"
                         @dragover(allowDrop(event, col['key']))
                         @dragleave(setOverColumn(''))
                         @drop(onDrop(event, col['key']))>
                    <header class="kb-col-head">
                        <h2>{{ col['label'] }}</h2>
                        <span class="kb-count">{{ col['cards'].length }}</span>
                    </header>

                    <div class="kb-col-body">
                        @foreach(col['cards'] as card)
                            @key(card['id'])
                            <boardcard :card="card" :column="col['key']" :busy="busy"
                                       :editing="editingId === card['id']" :draftSeed="draftText" />
                        @endforeach

                        @if(col['cards'].length === 0)
                            <p class="kb-empty">Thả thẻ vào đây</p>
                        @endif
                    </div>
                </section>
            @endforeach
        </div>
    @endblock

    @block('aside')
        <h2>Trang này kiểm chứng cái gì.</h2>
        <ul class="check-list">
            <li>Khoá <code>&#64;key(card['id'])</code> rời vùng <code>&#64;foreach</code> này sang vùng khác. Runtime phải nhận ra vẫn là một thẻ, không dựng lại node mới.</li>
            <li>Instance con <strong>bị dựng lại</strong> khi thẻ đổi cột — React và Vue cũng vậy, đây không phải giới hạn của Saola. Nên bản nháp phải do <strong>cha</strong> giữ; con soi lại từ prop trong <code>started()</code>. Mở ô <strong>Sửa</strong>, gõ dở, rồi kéo thẻ sang cột khác: nội dung đang gõ vẫn còn.</li>
            <li><code>&#64;foreach</code> lồng nhau: cột lặp ngoài, thẻ lặp trong — từng có bug thiếu spread khi lồng.</li>
            <li>Cập nhật lạc quan: bảng đổi ngay khi thả, server trả về trạng thái sau cùng; hỏng thì quay lui về ảnh chụp trước đó.</li>
            <li>Con không tự gọi API. <code>App.Event</code> là kênh con→cha duy nhất, vì chỉ cha mới giữ đủ trạng thái để quay lui.</li>
        </ul>
    @endblock
</template>

<link rel="stylesheet" href="/static/saola/board.css">

<script setup lang="ts">
    import type { BoardColumn } from '@web/app/services/DemoTypes';
    import type { HttpResponse } from '@saolabs/client';
    import { errorMessage } from '@web/app/services/Errors';
    let _off = [] as (() => void)[];

    function started() {
        // Đăng ký ở started(), gỡ ở destroyed(). Layout được tái dùng qua
        // điều hướng SPA nên không gỡ là mỗi lượt vào lại chồng thêm listener.
        _off = [
            App.Event.on('board:drag', (id: number) => setDragId(id)),
            App.Event.on('board:edit', (id: number) => openEditor(id)),
            App.Event.on('board:draft', (value: string) => setDraftText(value)),
            App.Event.on('board:cancel', () => closeEditor()),
            App.Event.on('board:rename', (payload: {id: number; title: string}) => rename(payload)),
            App.Event.on('board:delete', (id: number) => remove(id)),
        ];
    }

    function destroyed() {
        (_off || []).forEach((off) => typeof off === 'function' && off());
        _off = [];
    }

    /**
     * Trạng thái đang-sửa nằm ở CHA, không nằm trong thẻ.
     *
     * Kéo thẻ sang cột khác là chuyển khoá sang vùng @foreach khác nên
     * instance con bị dựng lại — bản nháp giữ trong con sẽ bay mất. Giữ ở
     * cha thì con chỉ việc soi lại từ prop trong started().
     */
    function openEditor(id: number) {
        const card = findCard(id);
        setDraftText(card ? card['title'] : '');
        setEditingId(id);
    }

    function closeEditor() {
        setEditingId(0);
        setDraftText('');
    }

    function findCard(id: number) {
        for (const col of board) {
            const found = col['cards'].find((card) => card['id'] === id);
            if (found) return found;
        }
        return null;
    }

    function allowDrop(event: DragEvent, column: string) {
        // Không preventDefault thì trình duyệt từ chối thả — mặc định của
        // HTML5 drag-and-drop là "không cho".
        event.preventDefault();
        if (overColumn !== column) setOverColumn(column);
    }

    async function onDrop(event: DragEvent, column: string) {
        event.preventDefault();
        setOverColumn('');
        if (!dragId || busy) return;

        const index = indexIn(column, event.clientY);
        const snapshot = board;
        setBoard(moveLocally(board, dragId, column, index));

        await commit(
            () => App.Http.post('/demo/board/move', { id: dragId, column, index }, options()),
            snapshot,
        );
        setDragId(0);
    }

    /** Vị trí thả suy từ toạ độ chuột so với tâm từng thẻ đang hiển thị. */
    function indexIn(column: string, clientY: number) {
        const body = document.querySelector('[data-col="' + column + '"] .kb-col-body');
        if (!body) return 0;

        const cards = [...body.querySelectorAll('.kb-card')];
        for (let i = 0; i < cards.length; i++) {
            const box = cards[i].getBoundingClientRect();
            if (clientY < box.top + box.height / 2) return i;
        }
        return cards.length;
    }

    /** Dựng lại bảng ngay phía client để giao diện phản hồi tức thì. */
    function moveLocally(columns: BoardColumn[], id: number, target: string, index: number): BoardColumn[] {
        const moving = columns.flatMap(col => col.cards).find(card => card.id === id);
        if (!moving) return columns;
        const stripped = columns.map((col) => ({
            key: col['key'],
            label: col['label'],
            cards: col['cards'].filter(card => card['id'] !== id),
        }));

        return stripped.map((col) => {
            if (col['key'] !== target) return col;
            const cards = [...col['cards']];
            cards.splice(Math.max(0, Math.min(index, cards.length)), 0, moving);
            return { key: col['key'], label: col['label'], cards };
        });
    }

    async function addCard(event: Event) {
        event.preventDefault();
        const title = note.trim();
        if (!title || busy) return;

        setNote('');
        await commit(() => App.Http.post('/demo/board/card', { title }, options()), board);
    }

    async function rename(payload: {id: number; title: string}) {
        const snapshot = board;
        setBoard(board.map((col) => ({
            key: col['key'],
            label: col['label'],
            cards: col['cards'].map((card) =>
                card['id'] === payload.id ? { ...card, title: payload.title } : card),
        })));

        closeEditor();
        await commit(
            () => App.Http.put('/demo/board/card/' + payload.id, { title: payload.title }, options()),
            snapshot,
        );
    }

    async function remove(id: number) {
        const snapshot = board;
        setBoard(board.map((col) => ({
            key: col['key'],
            label: col['label'],
            cards: col['cards'].filter((card) => card['id'] !== id),
        })));

        await commit(() => App.Http.delete('/demo/board/card/' + id, options()), snapshot);
    }

    /** Gửi mutation; hỏng thì trả bảng về đúng ảnh chụp trước khi đổi. */
    async function commit(request: () => Promise<HttpResponse<{data: {columns: BoardColumn[]}}>>, snapshot: BoardColumn[]) {
        setBusy(true);
        setError('');
        try {
            const response = await request();
            setBoard(response.data.data.columns);
        } catch (failure) {
            setBoard(snapshot);
            setError('Không lưu được, đã hoàn tác: ' + errorMessage(failure));
        } finally {
            setBusy(false);
        }
    }

    function options() {
        return {
            headers: {
                Accept: 'application/json',
                'X-Sao-Response': 'json',
                'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '',
            },
        };
    }
</script>
