{{-- Thẻ không giữ state nào: bản nháp do CHA giữ (draftSeed) và cha cũng là
     nơi đọc nó lúc lưu. Kéo thẻ sang cột khác là dựng lại instance này, nên
     mọi thứ con tự giữ đều bay — giữ ở cha thì không có gì để mất. --}}
@props({
    card: null,
    column: '',
    busy: false,
    editing: false,
    draftSeed: ''
})

<template>
    {{-- `$view` giữ nguyên đúng một '$' ở MỌI directive, kể cả `@dragstart`
         (không nằm trong danh sách event) và `@submit.prevent` (có modifier) —
         hai chỗ preprocessor không đụng tới. --}}
    <article class="kb-card"
             draggable="true"
             @dragstart(emit('drag', card['id']))>
        @if(editing)
            <form class="kb-edit" @submit.prevent(emit('rename', card['id']))>
                <input type="text" maxlength="120" aria-label="Tiêu đề thẻ"
                       @bind(draftSeed)
                       @input(emit('draft', event.target.value))>
                <div class="kb-edit-actions">
                    <button type="submit" class="kb-mini" @disabled(busy)>Lưu</button>
                    <button type="button" class="kb-mini kb-ghost"
                            @click(emit('cancel', card['id']))>Huỷ</button>
                </div>
            </form>
        @else
            <p class="kb-title">{{ card['title'] }}</p>
            <div class="kb-card-actions">
                <button type="button" class="kb-mini kb-ghost"
                        @click(emit('edit', card['id']))>Sửa</button>
                <button type="button" class="kb-mini kb-ghost" @disabled(busy)
                        @click(emit('delete', card['id']))>Xoá</button>
            </div>
        @endif
    </article>
</template>
