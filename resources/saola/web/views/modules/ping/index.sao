@states({
    count: 0,
    name: 'Saola',
    pings: []
})
<template>
    @extends(__layout__ + "public")
    @section('meta:title', 'Ping Module - Hydration & Reactivity Test | Saola Lab')
    @section('meta:description', 'Trang kiểm thử Hydration và tương tác phản ứng tối giản trong Saola: State hai chiều @bind, bộ đếm số lần bấm và vòng lặp phản hồi tức thì.')
    @section('meta:keywords', 'ping test, hydration test, saola ping, reactive test, minimal test bed')
    @block('content')
        <section @class({'ping', 'active': count !== 0})>
            <h1>Ping Module — Hydration Test</h1>
            <p>Hello, {{ name }}! 👋</p>

            <div>
                <button @click(setCount(count + 1))>Ping (+1)</button>
                <button @click(reset())>Reset</button>
                <span>Count: {{ count }}</span>
            </div>

            <div>
                <label>Your name:</label>
                <input type="text" name="name" placeholder="Type a name..." @bind(name) />
            </div>

            <button @click(addPing())>Add ping to list</button>
            <ul>
                @for(i = 0; i < count; i++)
                    <li>Ping #{{ i + 1 }}</li>
                @endfor
            </ul>
        </section>
    @endblock
</template>

<script setup lang="ts">
    function reset(){
        setCount(0);
    }
    function addPing(){
        setCount(count + 1);
    }
</script>
