<script setup lang="ts">
    import type { GridStatusFilter } from '@web/app/services/GridData';

    @props({initial: 0, title: 'Khai báo trong setup'}: {initial: number; title: string})
    @let(cardPath: string = __base__ + 'modules.components.statcard')
    @importView(cardPath as StatCard)
    @importView(__base__ + 'components.code-block' as CodeBlock)
    @asset(logo = 'images/logo.svg')
    @state(count: number = initial, status: GridStatusFilter = '')
    @computed(doubled: number = count * 2)
    const maxWin: number = window.innerWidth;
    
    function increment() { setCount(count + step); }
    function reset() { setCount(initial); setStatus(''); }
    function showStable() { setStatus('stable'); }
</script>

{{-- Khai báo bên ngoài vẫn dùng chung phạm vi với setup. --}}
@const(step: number = 1)

<template>
    @extends(__layout__ + 'lab')

    @block('main')
        <p class="kicker"><span>CÚ PHÁP · SETUP</span></p>
        <h1>{{ title }}</h1>
        <p class="lab-lead">Props, state, computed, asset và import view nằm trong script setup. Hằng số bước tăng được khai báo bên ngoài.</p>

        <div class="lab-toolbar">
            <button id="setup-increment" class="button button-primary" @click(increment())>
                <span>＋ Tăng (count + 1)</span>
            </button>
            <button id="setup-reset" class="button" @click(reset())>
                <span>↺ Đặt lại</span>
            </button>
            <button id="setup-stable" class="button" @click(showStable())>
                <span>Filter: stable</span>
            </button>
        </div>

        <div class="setup-grid">
            <div class="setup-card">
                <span class="setup-card__label">State · Counter</span>
                <div class="setup-card__value">
                    <strong id="setup-count" class="setup-num">{{ count }}</strong>
                </div>
                <span class="setup-card__hint">Khởi tạo từ prop <code>initial: 0</code></span>
            </div>

            <div class="setup-card">
                <span class="setup-card__label">Computed · x2</span>
                <div class="setup-card__value">
                    <strong id="setup-doubled" class="setup-num setup-num--accent">{{ doubled }}</strong>
                </div>
                <span class="setup-card__hint">Tự động tính: <code>count * 2</code></span>
            </div>

            <div class="setup-card">
                <span class="setup-card__label">Trạng thái filter</span>
                <div class="setup-card__value">
                    <span id="setup-status" @class({'setup-chip': true, 'setup-chip--active': status === 'stable'})>{{ status === '' ? 'Tất cả' : status }}</span>
                </div>
                <span class="setup-card__hint">Kiểu dữ liệu <code>GridStatusFilter</code></span>
            </div>

            <div class="setup-card">
                <span class="setup-card__label">Asset phân giải</span>
                <div class="setup-card__value">
                    <code id="setup-asset" class="setup-asset-code">{{ logo }}</code>
                </div>
                <span class="setup-card__hint">Directive <code>&#64;asset('images/logo.svg')</code></span>
            </div>
        </div>

        <div class="setup-import-preview">
            <StatCard label="View được import qua biến hệ thống" value="SSR + client" />
        </div>

        <div class="setup-code-section">
            <h2>Mã nguồn demo</h2>
            <p class="lab-lead">Phần trên đang chạy trực tiếp từ cấu trúc typesafe bên dưới.</p>
            <CodeBlock lang="sao">
@verbatim
&lt;script setup lang="ts"&gt;
    import type { GridStatusFilter } from '@web/app/services/GridData';

    &#64;props({initial: 0, title: 'Khai báo trong setup'}: {
        initial: number;
        title: string;
    })
    &#64;let(cardPath: string = __base__ + 'modules.components.statcard')
    &#64;importView(cardPath as StatCard)
    &#64;asset(logo = 'images/logo.svg')
    &#64;state(count: number = initial, status: GridStatusFilter = '')
    &#64;computed(doubled: number = count * 2)

    function increment() { setCount(count + step); }
    function reset() { setCount(initial); setStatus(''); }
    function showStable() { setStatus('stable'); }
&lt;/script&gt;

{{-- Khai báo bên ngoài vẫn dùng chung phạm vi với setup. --}}
&#64;const(step: number = 1)

&lt;template&gt;
    &#64;extends(__layout__ + 'lab')
    &#64;block('main')
        &lt;h1&gt;{{ title }}&lt;/h1&gt;
        &lt;button &#64;click(increment())&gt;Tăng&lt;/button&gt;
        &lt;button &#64;click(reset())&gt;Đặt lại&lt;/button&gt;
        &lt;button &#64;click(showStable())&gt;Chọn stable&lt;/button&gt;

        &lt;p&gt;Số lần bấm: {{ count }}&lt;/p&gt;
        &lt;p&gt;Nhân đôi: {{ doubled }}&lt;/p&gt;
        &lt;p&gt;Trạng thái: {{ status === '' ? 'Tất cả' : status }}&lt;/p&gt;
        &lt;p&gt;Asset: {{ logo }}&lt;/p&gt;
        &lt;StatCard label="View import qua biến" value="SSR + client" /&gt;
    &#64;endblock
&lt;/template&gt;
@endverbatim
            </CodeBlock>
        </div>
    @endblock

    @block('aside')
        <h2>Đặc tính typesafe trong setup</h2>
        <div class="directive-table">
            <div><div class="dt-key"><code>&#64;props</code></div><span>Khai báo tham số nhận vào với kiểu dữ liệu TypeScript và giá trị mặc định.</span><b>props</b></div>
            <div><div class="dt-key"><code>&#64;state</code></div><span>Tạo biến state kèm setter tự động (<code>setCount</code>, <code>setStatus</code>).</span><b>reactivity</b></div>
            <div><div class="dt-key"><code>&#64;computed</code></div><span>Biến tính toán phụ thuộc state, tự động cache và cập nhật reactive.</span><b>computed</b></div>
            <div><div class="dt-key"><code>&#64;let · &#64;const</code></div><span>Khai báo biến cục bộ hoặc hằng số có thể dùng chung ngoài template.</span><b>scope</b></div>
            <div><div class="dt-key"><code>&#64;importView</code></div><span>Nạp component động qua biến hoặc tĩnh qua chuỗi namespace.</span><b>components</b></div>
            <div><div class="dt-key"><code>&#64;asset</code></div><span>Tự động phân giải đường dẫn tài nguyên tĩnh theo context hiện hành.</span><b>assets</b></div>
        </div>

        <p class="lab-note">
            Cấu trúc <code>&lt;script setup lang="ts"&gt;</code> được Saola Compiler biên dịch đồng thời:
            sinh ra Blade Template (SSR) an toàn không eval và TypeScript Controller (CSR) tương ứng.
        </p>
    @endblock
</template>

