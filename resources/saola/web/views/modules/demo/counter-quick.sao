{{-- Mặt chữ 3: object với `:` ngoài script — gõ nhanh, không kiểu; compiler ép về cùng dạng. --}}
@props({label: 'Object · :', step: 1})
@states({count: 0, history: []})
@computed(doubled = count * 2)

<template>
    <article class="dc-card">
        <span class="dc-card__label">{{ label }}</span>
        <strong class="dc-num">{{ count }}</strong>
        <span class="dc-meta">×2 = {{ doubled }} · {{ history.length }} lần bấm</span>
        <div class="dc-actions">
            <button type="button" class="button button-primary dc-bump" @click(bump())><span>＋ {{ step }}</span></button>
            <button type="button" class="button button-light dc-reset" @click(reset()) title="Đặt lại về 0"><span>↺ Đặt lại</span></button>
        </div>
    </article>
</template>

<script setup>
    function bump() { setCount(count + step); setHistory([...history, step]); }
    function reset() { setCount(0); setHistory([]); }
</script>
