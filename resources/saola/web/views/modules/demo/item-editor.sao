@import('web.components.code-block')
<script setup lang="ts">
interface UserItem {
    id: number;
    name: string;
    email: string;
    status: string;
}

@props({
    users: [
        { id: 1, name: 'Nguyễn Văn An', email: 'an.nguyen@saola.dev', status: 'active' },
        { id: 2, name: 'Trần Thị Bình', email: 'binh.tran@saola.dev', status: 'inactive' },
        { id: 3, name: 'Lê Hoàng Cường', email: 'cuong.le@saola.dev', status: 'active' }
    ]
}: { users: UserItem[] })

@states({
    userList: users,
    showForm: false,
    isEdit: false,
    formId: 0,
    formName: '',
    formEmail: '',
    formStatus: 'active',
    formError: '',
    nextId: 4
}: {
    userList: UserItem[];
    showForm: boolean;
    isEdit: boolean;
    formId: number;
    formName: string;
    formEmail: string;
    formStatus: string;
    formError: string;
    nextId: number;
})

function showEditForm(user: UserItem) {
    if (!user) return;
    setFormId(user.id);
    setFormName(user.name);
    setFormEmail(user.email);
    setFormStatus(user.status);
    setFormError('');
    setIsEdit(true);
    setShowForm(true);
}

function handleAdd() {
    setFormId(0);
    setFormName('');
    setFormEmail('');
    setFormStatus('active');
    setFormError('');
    setIsEdit(false);
    setShowForm(true);
}

function handleCancel() {
    setShowForm(false);
    setIsEdit(false);
    setFormError('');
}

function handleSave() {
    const trimmedName = formName.trim();
    const trimmedEmail = formEmail.trim();

    if (trimmedName === '') {
        setFormError('Vui lòng nhập họ và tên.');
        return;
    }

    if (trimmedEmail === '' || !trimmedEmail.includes('@')) {
        setFormError('Vui lòng nhập địa chỉ email hợp lệ.');
        return;
    }

    if (isEdit) {
        const updated = userList.map((u: UserItem) => {
            if (u.id === formId) {
                return { ...u, name: trimmedName, email: trimmedEmail, status: formStatus };
            }
            return u;
        });
        setUserList(updated);
    } else {
        const newId = nextId;
        setNextId(newId + 1);
        const newUser: UserItem = {
            id: newId,
            name: trimmedName,
            email: trimmedEmail,
            status: formStatus
        };
        setUserList([...userList, newUser]);
    }

    setShowForm(false);
    setIsEdit(false);
    setFormError('');
}

function deleteUser(id: number) {
    setUserList(userList.filter((u: UserItem) => u.id !== id));
}

function reverseUserList() {
    setUserList([...userList].reverse());
}

function resetDefault() {
    setUserList([
        { id: 1, name: 'Nguyễn Văn An', email: 'an.nguyen@saola.dev', status: 'active' },
        { id: 2, name: 'Trần Thị Bình', email: 'binh.tran@saola.dev', status: 'inactive' },
        { id: 3, name: 'Lê Hoàng Cường', email: 'cuong.le@saola.dev', status: 'active' }
    ]);
    setNextId(4);
}
</script>

<template>
    @extends(__layout__ + 'lab')

    @block('main')
        <p class="kicker"><span>ỨNG DỤNG THẬT · MODAL EDITOR</span></p>
        <h1>Modal Editor &amp; Quản lý Item.</h1>
        <p class="lab-lead">
            Quản lý danh sách thực tế với hộp thoại modal popup, liên kết dữ liệu hai chiều qua <code>&#64;bind</code>,
            thực hiện thêm mới, cập nhật, xoá và đảo thứ tự tức thì trên DOM với reconciliation <code>&#64;key</code>.
        </p>
        <div class="lab-toolbar editor-toolbar">
            <button class="button button-primary" @click(handleAdd())>
                <span>＋ Thêm người dùng</span>
            </button>
            <button class="button" @click(reverseUserList())>
                <span>⇅ Đảo thứ tự</span>
            </button>
            <button class="button" @click(resetDefault())>
                <span>↺ Đặt lại</span>
            </button>
            <div class="editor-pill-group">
                <span class="editor-pill">Tổng: <strong>{{ userList.length }}</strong></span>
            </div>
        </div>

        @if (showForm)
            <div class="modal-overlay" @click(handleCancel())></div>
            <div class="modal-dialog" role="dialog" aria-modal="true">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2>{{ isEdit ? 'Chỉnh sửa' : 'Thêm mới' }} người dùng</h2>
                        <button class="modal-close-btn" @click(handleCancel()) aria-label="Đóng">&times;</button>
                    </div>

                    @if (formError !== '')
                        <div class="modal-alert" role="alert">
                            <span>⚠️</span> {{ formError }}
                        </div>
                    @endif

                    <div class="modal-body">
                        <form class="modal-form" @submit.prevent(handleSave())>
                            <div class="form-group">
                                <label for="name">Họ và tên <span class="text-danger">*</span></label>
                                <input type="text" id="name" placeholder="Ví dụ: Nguyễn Văn An" @bind(formName) />
                            </div>

                            <div class="form-group">
                                <label for="email">Địa chỉ Email <span class="text-danger">*</span></label>
                                <input type="email" id="email" placeholder="Ví dụ: an.nguyen@saola.dev" @bind(formEmail) />
                            </div>

                            <div class="form-group">
                                <label for="status">Trạng thái tài khoản</label>
                                <select id="status" @bind(formStatus)>
                                    <option value="active">Hoạt động (Active)</option>
                                    <option value="inactive">Tạm khoá (Inactive)</option>
                                </select>
                            </div>

                            <div class="modal-footer">
                                <button type="button" class="button" @click(handleCancel())>Huỷ bỏ</button>
                                <button type="submit" class="button button-primary">{{ isEdit ? 'Cập nhật' : 'Lưu người dùng' }}</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        @endif

        <div class="user-list">
            @foreach(userList as user)
                @key(user['id'])
                <div class="user-card">
                    <div class="user-card__lead">
                        <div class="user-avatar">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </div>
                        <div class="user-info">
                            <div class="user-title-row">
                                <strong class="user-name">{{ user['name'] }}</strong>
                                <span class="user-id">#{{ user['id'] }}</span>
                            </div>
                            <div class="user-email">{{ user['email'] }}</div>
                        </div>
                    </div>
                    <div class="user-card__tail">
                        <span @class({'status-badge', 'status-active': user['status'] === 'active', 'status-inactive': user['status'] !== 'active'})>
                            {{ user['status'] === 'active' ? '● Hoạt động' : '○ Tạm khoá' }}
                        </span>
                        <div class="user-card__actions">
                            <button class="btn-action btn-edit" title="Chỉnh sửa" @click(showEditForm(user))>
                                <span>Sửa</span>
                            </button>
                            <button class="btn-action btn-delete" title="Xoá" @click(deleteUser(user['id']))>
                                <span>Xoá</span>
                            </button>
                        </div>
                    </div>
                </div>
            @endforeach
        </div>

        @if (userList.length === 0)
            <div class="empty-state">
                <div class="empty-icon">👥</div>
                <h3>Chưa có người dùng nào</h3>
                <p>Danh sách hiện đang trống. Hãy thêm người dùng mới hoặc bấm đặt lại.</p>
                <button class="button button-primary" @click(handleAdd())>＋ Thêm người dùng</button>
            </div>
        @endif
    @endblock

    @block('aside')
        <h2>Cơ chế hoạt động của Modal &amp; State.</h2>
        <ul class="check-list">
            <li><strong>2-Way Binding phẳng (<code>&#64;bind</code>):</strong> Ràng buộc trực tiếp với getter/setter của StateManager trên tầng khoá phẳng (<code>formName</code>, <code>formEmail</code>, <code>formStatus</code>), giúp dữ liệu input và state đồng bộ tức thì.</li>
            <li><strong>Reactivity Modal với <code>&#64;if</code>:</strong> Modal được điều khiển bởi state boolean <code>showForm</code>; chỉ vùng marker của modal được mount/unmount khi trạng thái thay đổi.</li>
            <li><strong>Danh sách Reconciliation (<code>&#64;foreach + &#64;key</code>):</strong> Giúp theo dõi danh tính từng dòng qua khoá <code>user['id']</code>, bảo toàn node DOM khi thêm, sửa hoặc đảo thứ tự thay vì vẽ lại toàn bộ mảng.</li>
            <li><strong>Parity SSR và CSR:</strong> Cấu trúc view đồng bộ hoàn toàn giữa đầu ra Blade template (PHP) và TypeScript runtime (Client).</li>
        </ul>
        <p class="lab-note">
            Khi sử dụng form trong modal, khuyến nghị gán flat state thay vì object lồng nhau để tận dụng tối đa cơ chế setter tự động và subscriptions riêng biệt của Saola StateManager.
        </p>
    @endblock

    @block('source')
        <h2 class="lab-source-title">Code của demo này</h2>
        <p class="lab-source-note">Props vào, state riêng của instance, form sửa tại chỗ.</p>
        <code-block lang="sao">
@verbatim
&#64;props({ users: [] }: { users: UserItem[] })

&#64;states({
    userList: users,
    showForm: false,
    formName: ''
})

&lt;template&gt;
    &#64;foreach(userList as user)
        &#64;key(user['id'])
        &lt;tr&gt;
            &lt;td&gt;{{ user['name'] }}&lt;/td&gt;
            &lt;td&gt;&lt;button &#64;click(showEditForm(user))&gt;Sửa&lt;/button&gt;&lt;/td&gt;
        &lt;/tr&gt;
    &#64;endforeach

    &#64;if(showForm)
        &lt;form &#64;submit.prevent(save())&gt;
            &lt;input type="text" &#64;bind(formName)&gt;
        &lt;/form&gt;
    &#64;endif
&lt;/template&gt;
@endverbatim
        </code-block>
    @endblock
</template>

