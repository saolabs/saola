@import('web.modules.demo.featurecard')

@states({
    count: 3,
    name: 'Saola',
    selectedPanel: 'state',
    status: 'ready',
    isVisible: true,
    isLocked: false,
    accepted: false,
    selectedRuntime: 'blade',
    note: '',
    sampleItems: [
        { id: 1, label: 'Blade output', enabled: true },
        { id: 2, label: 'JavaScript view', enabled: true },
        { id: 3, label: 'Scoped CSS', enabled: false }
    ]
})

@const(MAX_COUNT = 10)

<template>
    @extends(__layout__ + 'lab')

    @block('main')
        <p class="kicker"><span>DEMO · TỔNG QUAN</span></p>
        <h1>Cú pháp đang chạy thật.</h1>
        <p class="lab-lead">
            Trang này là fixture trực tiếp của compiler: cùng một file <code>index.sao</code>
            sinh Blade cho lần tải đầu và TypeScript cho mọi tương tác sau hydration.
        </p>

        <div class="lab-index">
            <a href="/demo/await">
                <span>Dữ liệu</span>
                <strong>Nạp bất đồng bộ</strong>
                <p>Cùng một URL trả HTML cho trình duyệt và JSON cho fetch. So sánh đường SSR với đường CSR.</p>
            </a>
            <a href="/demo/foreach">
                <span>Runtime</span>
                <strong>Danh sách &amp; reconciliation</strong>
                <p>Thêm, xoá, đảo thứ tự, refetch — xem chỗ nào giữ được DOM và chỗ nào bị dựng lại.</p>
            </a>
            <a href="/demo/lifecycle">
                <span>Runtime</span>
                <strong>Vòng đời &amp; PageCache</strong>
                <p>Bảy chuyển trạng thái, và state sống sót qua back/forward nhờ PageCache.</p>
            </a>
            <a href="/roster">
                <span>Ứng dụng thật</span>
                <strong>Roster — CRUD qua API</strong>
                <p>Danh sách sửa được, gọi API thật, view con báo ngược lên cha bằng <code>App.Event</code>. Chạy trong shell <code>workspace</code>.</p>
            </a>
        </div>

        <h2>Playground</h2>
        <div class="tab-tape" role="tablist" aria-label="Nhóm tính năng">
            <button data-demo-tab="state" @class({'is-active': selectedPanel === 'state'}) @click(setSelectedPanel('state'))>State &amp; event</button>
            <button data-demo-tab="binding" @class({'is-active': selectedPanel === 'binding'}) @click(setSelectedPanel('binding'))>Binding</button>
            <button data-demo-tab="flow" @class({'is-active': selectedPanel === 'flow'}) @click(setSelectedPanel('flow'))>Control flow</button>
        </div>

        <div data-demo-panel="state" @class({'card-grid', 'is-hidden': selectedPanel !== 'state'})>
            <featurecard number="01" title="Reactive state" source="&#64;states({ count: 3 })" tone="pink">
                <div class="counter-row">
                    <button data-demo-count="decrease" aria-label="Giảm count" @click(setCount(count - 1)) @disabled(count === 0)>Giảm</button>
                    <strong data-demo-count-output>{{ count }}</strong>
                    <button data-demo-count="increase" aria-label="Tăng count" @click(setCount(count + 1)) @disabled(count === MAX_COUNT)>Tăng</button>
                </div>
                <div class="progress-track"><i @style({width: `${count * 10}%`})></i></div>
                <small>Giới hạn mẫu: 0–{{ MAX_COUNT }}</small>
            </featurecard>

            <featurecard number="02" title="Events &amp; setup" source="&#64;click(setCount(3))" tone="cyan">
                <p>Event inline cập nhật state; khối <code>&lt;script setup&gt;</code> khai báo method tái sử dụng.</p>
                <button @click(setCount(3))>Đặt lại count</button>
                <button @dblclick(setCount(MAX_COUNT))>Nhấp đúp để đạt tối đa</button>
            </featurecard>

            <featurecard number="09" title="Props, import &amp; children" source="&#64;props · &#64;import · &#64;children" tone="yellow">
                <p>Chính khung này là component <code>featurecard</code> được import. Tiêu đề và số là props; đoạn văn này đi qua slot <code>&#64;children</code>.</p>
            </featurecard>
        </div>

        <div data-demo-panel="binding" @class({'card-grid', 'is-hidden': selectedPanel !== 'binding'})>
            <featurecard number="03" title="Two-way binding" source="&#64;bind(name)" tone="cyan">
                <label class="field-label" for="demo-name">Tên mẫu</label>
                <input id="demo-name" data-demo-name type="text" placeholder="Nhập một tên" @bind(name) @required(true)>
                <p class="live-output">Xin chào, <strong data-demo-name-output>{{ name }}</strong>.</p>
            </featurecard>

            <featurecard number="04" title="Boolean attributes" source="&#64;checked · &#64;disabled · &#64;readonly" tone="yellow">
                <label class="check-row"><input data-demo-accept type="checkbox" @bind(accepted) @checked(accepted)> Đã đọc tài liệu cú pháp</label>
                <label class="check-row"><input type="checkbox" @bind(isLocked) @checked(isLocked)> Khoá trường ghi chú</label>
                <input type="text" placeholder="Ghi chú mẫu" @bind(note) @readonly(isLocked)>
                <button data-demo-continue @disabled(!accepted)>Tiếp tục</button>
            </featurecard>

            <featurecard number="05" title="Visibility &amp; attributes" source="&#64;class · &#64;attr · &#64;style" tone="pink">
                <button data-demo-visibility @click(setIsVisible(!isVisible))>Bật / tắt hai vùng</button>
                <p data-demo-visible="true" @class({'visibility-sample', 'is-hidden': !isVisible})>Vùng này hiện khi state là true.</p>
                <p data-demo-visible="false" @class({'visibility-sample', 'is-hidden': isVisible})>Vùng này hiện khi state là false.</p>
                <a @attr({href: '/docs/compiler', title: `Compiler cho ${name}`})>Mở trang compiler</a>
            </featurecard>
        </div>

        <div data-demo-panel="flow" @class({'card-grid', 'is-hidden': selectedPanel !== 'flow'})>
            <featurecard number="06" title="If / elseif / else" source="&#64;if(status === 'ready')" tone="yellow">
                <div class="status-buttons">
                    <button data-demo-status="ready" @click(setStatus('ready'))>Ready</button>
                    <button data-demo-status="building" @click(setStatus('building'))>Building</button>
                    <button data-demo-status="error" @click(setStatus('error'))>Error</button>
                </div>
                @if(status === 'ready')
                    <p data-demo-status-output class="status-card status-ready">Sẵn sàng biên dịch.</p>
                @elseif(status === 'building')
                    <p data-demo-status-output class="status-card status-building">Đang biên dịch fixture.</p>
                @else
                    <p data-demo-status-output class="status-card status-error">Trạng thái lỗi mẫu.</p>
                @endif
            </featurecard>

            <featurecard number="07" title="For &amp; foreach" source="&#64;for · &#64;foreach · &#64;key" tone="pink">
                <div class="number-run">
                    @for(i = 0; i < count; i++)
                        <span>{{ i + 1 }}</span>
                    @endfor
                </div>
                <ul class="sample-list">
                    @foreach(sampleItems as item)
                        @key(item['id'])
                        <li @class({'is-enabled': item['enabled']})>{{ item['label'] }}</li>
                    @endforeach
                </ul>
            </featurecard>

            <featurecard number="08" title="Switch" source="&#64;switch(selectedRuntime)" tone="cyan">
                <select data-demo-runtime @bind(selectedRuntime)>
                    <option value="blade">Blade</option>
                    <option value="typescript">TypeScript</option>
                    <option value="css">Scoped CSS</option>
                </select>
                @switch(selectedRuntime)
                    @case('typescript')
                        <p data-demo-runtime-output class="runtime-result">Client output giữ state, event và lifecycle.</p>
                        @break
                    @case('css')
                        <p data-demo-runtime-output class="runtime-result">Selector được gắn scope theo view.</p>
                        @break
                    @default
                        <p data-demo-runtime-output class="runtime-result">Server output trả HTML hoàn chỉnh.</p>
                @endswitch
            </featurecard>
        </div>
    @endblock

    @block('aside')
        <h2>Phạm vi cú pháp.</h2>
        <div class="directive-table">
            <div><div class="dt-key">Khai báo</div><span><code>&#64;states</code> <code>&#64;props</code> <code>&#64;const</code> <code>&#64;let</code> <code>&#64;vars</code> <code>&#64;import</code> <code>&#64;await</code></span><b>declaration</b></div>
            <div><div class="dt-key">Template</div><span><code>&#64;extends</code> <code>&#64;block</code> <code>&#64;section</code> <code>&#64;yield</code> <code>&#64;include</code> <code>&#64;children</code> <code>&#64;exec</code></span><b>template</b></div>
            <div><div class="dt-key">Điều khiển</div><span><code>&#64;if</code> <code>&#64;foreach</code> <code>&#64;for</code> <code>&#64;while</code> <code>&#64;switch</code> <code>&#64;break</code> <code>&#64;continue</code> <code>&#64;ssr</code></span><b>control flow</b></div>
            <div><div class="dt-key">Ràng buộc</div><span><code>&#64;attr</code> <code>&#64;class</code> <code>&#64;style</code> <code>&#64;bind</code> <code>&#64;val</code> và các thuộc tính boolean</span><b>binding</b></div>
            <div><div class="dt-key">Form &amp; quyền</div><span><code>&#64;csrf</code> <code>&#64;method</code> <code>&#64;auth</code> <code>&#64;guest</code> <code>&#64;can</code> <code>&#64;error</code> — cần request, session hoặc policy thật</span><b>form</b></div>
            <div><div class="dt-key">Khối component</div><span><code>&lt;script setup lang="ts"&gt;</code>, <code>&lt;style scoped&gt;</code>, biến hệ thống, wrapper</span><b>block</b></div>
        </div>

        @ssr
            <p class="lab-note"><strong>Chỉ có trong HTML từ server:</strong> khối này nằm trong <code>&#64;ssr</code> nên compiler không đưa sang JavaScript view — điều hướng SPA vào lại trang sẽ không còn thấy nó.</p>
        @endssr

        <p class="lab-note">Fixture: <code>web.modules.demo.index</code> · chữ ký đầy đủ ở <a href="/docs/directives">tham chiếu directive</a>.</p>
    @endblock
</template>

<script setup lang="ts">
    // state và setter là biến closure của view — gọi trần, không qua `this`.
    export default {
        name: 'DemoIndexPage',

        increment() { if (count < MAX_COUNT) setCount(count + 1); },
        decrement() { if (count > 0) setCount(count - 1); },

        reset() {
            setCount(3);
            setName('Saola');
            setStatus('ready');
            setIsVisible(true);
            setIsLocked(false);
            setAccepted(false);
            setSelectedRuntime('blade');
            setNote('');
        }
    };
</script>
