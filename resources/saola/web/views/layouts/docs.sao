<template>
    @extends(__layout__ + "public")
    @block('content')
        <div class="docs-shell">
            <aside class="docs-nav" aria-label="Điều hướng tài liệu">
                <div class="docs-nav-inner">
                    <p class="docs-nav-group">Bắt đầu &amp; Nền tảng</p>
                    <a href="/docs">Tổng quan &amp; Hợp đồng</a>
                    <a href="/docs/getting-started">Cài đặt &amp; route đầu tiên</a>
                    <a href="/docs/architecture">Kiến trúc hệ thống 4 tầng</a>
                    <a href="/docs/sao-file">Cấu trúc file .sao</a>

                    <p class="docs-nav-group">Cú pháp View &amp; Template</p>
                    <a href="/docs/directives">Tham chiếu directive (@)</a>
                    <a href="/docs/tag-directives">Directive trên thẻ (#)</a>
                    <a href="/docs/system-vars">Biến hệ thống</a>
                    <a href="/docs/helpers">Hàm dùng trong biểu thức</a>

                    <p class="docs-nav-group">Reactivity &amp; Client Runtime</p>
                    <a href="/docs/reactivity">State &amp; Reactivity</a>
                    <a href="/docs/lifecycle">Vòng đời View &amp; Marker</a>
                    <a href="/docs/runtime">Runtime &amp; Hydration</a>
                    <a href="/docs/router">Router &amp; PageCache</a>
                    <a href="/docs/client-services">Dịch vụ phía client</a>

                    <p class="docs-nav-group">Kiến trúc Backend Laravel</p>
                    <a href="/docs/contexts">Context, module &amp; controller</a>
                    <a href="/docs/services">Service &amp; tầng nghiệp vụ</a>
                    <a href="/docs/repository">Repository &amp; truy vấn</a>
                    <a href="/docs/mask">Mask, model &amp; collection</a>
                    <a href="/docs/validator">Validator &amp; dữ liệu vào</a>
                    <a href="/docs/response">Response &amp; thương lượng đầu ra</a>
                    <a href="/docs/core-kit">Hạ tầng lõi Core Kit</a>

                    <p class="docs-nav-group">Công cụ &amp; Vận hành</p>
                    <a href="/docs/compiler">Compiler &amp; AST Engine</a>
                    <a href="/docs/build">Build, CLI &amp; cấu hình</a>
                    <a href="/components">Thư viện component</a>
                    <a href="/docs/status">Giới hạn kỹ thuật &amp; Roadmap</a>
                </div>
            </aside>

            <main class="docs-main">
                @useBlock('doc')
            </main>

            <aside class="docs-toc" aria-label="Mục lục nội dung">
                <div class="docs-toc-inner">
                    <p class="docs-toc-title">Trên trang này</p>
                    <ul class="docs-toc-list" id="docs-toc-list">
                        <!-- Sẽ được populate tự động bằng script hoặc khai báo trong trang -->
                    </ul>
                </div>
            </aside>
        </div>
    @endblock
</template>

<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js" data-manual></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-markup-templating.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-php.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-json.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-typescript.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-bash.min.js"></script>

<script setup lang="ts">
    import HighlightService from '@web/app/services/HighlightService';

    let _offNav = null as (() => void) | null;
    let _offSettled = null as (() => void) | null;

    // Layout được TÁI DÙNG khi điều hướng giữa các trang docs (layout diff),
    // nên started() chỉ chạy một lần — phải nghe router để đồng bộ lại.
    //
    // Trước đây chỗ này dùng MutationObserver + requestAnimationFrame và sai
    // hai đường: rAF bị treo khi tab/pane ẩn (nav kẹt ở trang cũ), và khi vào
    // docs từ layout KHÁC thì sync() chạy lúc `location.pathname` VẪN LÀ TRANG
    // CŨ — router mount DOM trước, pushState sau — nên markCurrent() không
    // khớp link nào và thanh nav mất highlight. afterEach chạy sau khi URL đã
    // cập nhật, là tín hiệu tất định. Giống layouts/lab.sao.
    function started() {
        // `view:settled` bắn khi render `@await` thay skeleton bằng nội dung
        // thật: node cũ (đã tô màu) bị thay, phải trang trí lại lượt nữa.
        _offNav = App.Router.afterEach(() => sync());
        _offSettled = App.Event.on('view:settled', () => sync());
        sync();
    }

    function resumed() { sync(); }

    function stopped() { teardown(); }
    function destroyed() { teardown(); }

    function teardown() {
        if (_offNav) { _offNav(); _offNav = null; }
        if (_offSettled) { _offSettled(); _offSettled = null; }
    }

    function sync() {
        markCurrent();
        generateTOC();

        const main = document.querySelector('.docs-main');
        if (main) {
            HighlightService.highlight(main);
        }
    }

    function markCurrent() {
        const here = window.location.pathname.replace(/\/+$/, '') || '/';
        document.querySelectorAll('.docs-nav a').forEach(a => {
            a.classList.toggle('is-current', a.getAttribute('href') === here);
        });
    }

    function generateTOC() {
        const list = document.getElementById('docs-toc-list');
        if (!list) return;
        list.innerHTML = '';

        const headings = document.querySelectorAll<HTMLElement>('.docs-main h2, .docs-main h3');
        if (headings.length === 0) {
            list.innerHTML = '<li><span class="toc-empty">Chưa có mục lục</span></li>';
            return;
        }

        headings.forEach(heading => {
            if (!heading.id) {
                heading.id = heading.innerText.toLowerCase().replace(/[\s\W-]+/g, '-');
            }
            const li = document.createElement('li');
            li.className = 'toc-item ' + (heading.tagName.toLowerCase() === 'h3' ? 'toc-h3' : 'toc-h2');
            const a = document.createElement('a');
            a.href = '#' + heading.id;
            a.innerText = heading.innerText;
            li.appendChild(a);
            list.appendChild(li);
        });
    }
</script>
