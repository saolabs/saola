                    <a href="/demo/setup">Setup typesafe</a>
                    <a href="/demo/declarations">Khai báo State & Props</a>
                    <a href="/demo/tag-directives">Directive viết trên thẻ</a>
                    <a href="/demo/foreach">Danh sách &amp; reconciliation</a>
                    <a href="/demo/lifecycle">Vòng đời &amp; PageCache</a>

                    <p class="docs-nav-group">Ứng dụng thật</p>
                    <a href="/demo/market">Biểu đồ giá realtime</a>
                    <a href="/demo/board">Kanban — kéo thả</a>
                    <a href="/demo/emit">Sự kiện con → cha</a>
                    <a href="/demo/grid">Bảng dữ liệu 3.800 dòng</a>
                    <a href="/demo/stream">Luồng sự kiện SSE</a>
                    <a href="/demo/item-editor">Item Editor</a>
                    <a href="/roster">Roster — CRUD qua API</a>
                    <a href="/todo-list">Todo — state cục bộ</a>

                    <p class="docs-nav-group">Tài liệu</p>
                    <a href="/docs/directives">Tham chiếu directive</a>
                    <a href="/docs/status">Giới hạn đã biết</a>
                </div>
            </aside>

            <main class="docs-main lab-main">
                {{-- Tên block KHÔNG được chứa dấu gạch ngang: nhánh Blade nhận
                     đúng còn nhánh JS bỏ qua, biến @useBlock thành text thô —
                     outlet biến mất khi CSR.

                     Ở đây KHÔNG dùng @yield: khi layout được tái dùng qua điều
                     hướng SPA, Yield bị dựng lại thành một cặp marker THỨ HAI
                     cùng id thay vì claim cặp có sẵn, nên nội dung section của
                     trang cũ nằm lại bên cạnh trang mới. Xem /docs/status. --}}
                @useBlock('main')
                {{-- Code ví dụ của chính trang demo, nằm ngay dưới phần chạy
                     thật: xem được thứ vừa bấm là do đoạn nào sinh ra. --}}
                @useBlock('source')
