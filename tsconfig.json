{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["resources/js/*"],
      "@sao/*": ["resources/saola/*"],
      "@app/*": ["resources/saola/_app/*"],
      "@web/*": ["resources/saola/web/*"],
      "@admin/*": ["resources/saola/admin/*"],
      "@mobile/*": ["resources/saola/mobile/*"]
    }
  },
  "include": [
    "resources/js/**/*",
    "resources/saola/**/*"
  ],
  "exclude": [
    "node_modules",
    "public",
    "vendor"
  ]
}
