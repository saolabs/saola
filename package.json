{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run build:web",
        "build:web": "VITE_CONTEXT=web vite build",
        "build:web:local": "npm --prefix ../client run build && VITE_CONTEXT=web SAOLA_LOCAL_CLIENT=true vite build",
        "build:admin": "VITE_CONTEXT=admin vite build",
        "build:mobile": "VITE_CONTEXT=mobile vite build",
        "build:all": "VITE_CONTEXT=default vite build",
        "dev": "npm run dev:web",
        "dev:server": "php artisan serve --host=127.0.0.1 --port=8080 --no-reload",
        "dev:client": "npm --prefix ../client run dev",
        "dev:web": "npm --prefix ../client run build && VITE_CONTEXT=web SAOLA_LOCAL_CLIENT=true concurrently -k -n server,vite,client -c yellow,cyan,magenta \"npm:dev:server\" \"vite\" \"npm:dev:client\"",
        "dev:web:local": "npm run dev:web",
        "dev:admin": "npm --prefix ../client run build && VITE_CONTEXT=admin SAOLA_LOCAL_CLIENT=true concurrently -k -n server,vite,client -c yellow,cyan,magenta \"npm:dev:server\" \"vite\" \"npm:dev:client\"",
        "dev:mobile": "npm --prefix ../client run build && VITE_CONTEXT=mobile SAOLA_LOCAL_CLIENT=true concurrently -k -n server,vite,client -c yellow,cyan,magenta \"npm:dev:server\" \"vite\" \"npm:dev:client\"",
        "build:views": "sao-compile all",
        "build:views:web": "sao-compile web",
        "build:views:admin": "sao-compile admin",
        "build:views:mobile": "sao-compile mobile",
        "dev:views": "sao-compile all --watch",
        "dev:views:web": "sao-compile web --watch",
        "dev:views:admin": "sao-compile admin --watch",
        "dev:views:mobile": "sao-compile mobile --watch",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest --coverage",
        "saola:compile": "sao-compile web",
        "saola:compile:all": "sao-compile all",
        "saola:compile:admin": "sao-compile admin",
        "saola:compile:web": "sao-compile web",
        "saola:compile:mobile": "sao-compile mobile",
        "saola:build": "npm run build:web",
        "saola:build:all": "npm run build:all",
        "saola:build:admin": "npm run build:admin",
        "saola:build:web": "npm run build:web",
        "saola:build:mobile": "npm run build:mobile",
        "saola:dev": "npm run dev:web",
        "saola:dev:admin": "npm run dev:admin",
        "saola:dev:web": "npm run dev:web",
        "start": "npm run dev"
    },
    "devDependencies": {
        "@saolabs/compiler": "^1.0.0",
        "@tailwindcss/vite": "^4.0.0",
        "@vitest/coverage-v8": "^3.0.0",
        "@vitest/ui": "^3.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.2.3",
        "esbuild": "^0.25.10",
        "jsdom": "^25.0.0",
        "laravel-vite-plugin": "^1.2.0",
        "tailwindcss": "^4.0.0",
        "terser-webpack-plugin": "^5.3.14",
        "vite": "^6.4.0",
        "vitest": "^3.0.0",
        "webpack": "^5.95.0",
        "webpack-cli": "^5.1.4"
    },
    "dependencies": {
        "@saolabs/client": "^1.0.0"
    },
    "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
