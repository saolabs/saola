{
    "packages": {
        "saola": "1.0.0"
    },
    "paths": {
        "resources": "resources",
        "saoView": "resources/saola",
        "bladeView": "resources/views",
        "compiled": "resources/js/saola",
        "public": "public/static/saola"
    },
    "output": {
        "default": "app/js",
        "contexts": {
            "admin": "admin/js",
            "web": "web/js",
            "mobile": "mobile/js",
            "default": "app/js"
        }
    },
    "contexts": {
        "web": {
            "name": "Web",
            "app": ["web/app"],
            "views": {
                "web": "web/views"
            },
            "blade": {
                "web": "web"
            },
            "compiled": {
                "views": "web/views",
                "app": "web/app",
                "registry": "web/registry.js"
            },
            "registry": {
                "lazy": false
            }
        },
        "admin": {
            "name": "Admin Panel",
            "app": ["admin/app"],
            "views": {
                "admin": "admin/views"
            },
            "blade": {
                "admin": "admin"
            },
            "compiled": {
                "views": "admin/views",
                "app": "admin/app",
                "registry": "admin/registry.js"
            }
        },
        "mobile": {
            "name": "Mobile",
            "app": ["mobile/app"],
            "views": {
                "mobile": "mobile/views"
            },
            "blade": {
                "mobile": "mobile"
            },
            "compiled": {
                "views": "mobile/views",
                "app": "mobile/app",
                "registry": "mobile/registry.js"
            }
        },
        "default": {
            "name": "All Contexts",
            "app": [
                "admin/app",
                "web/app",
                "mobile/app"
            ],
            "views": {
                "web": "web/views",
                "admin": "admin/views",
                "mobile": "mobile/views"
            },
            "blade": {
                "web": "web",
                "admin": "admin",
                "mobile": "mobile"
            },
            "compiled": {
                "views": "app/views",
                "app": "app/app",
                "registry": "app/registry.js"
            }
        }
    }
}